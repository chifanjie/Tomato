{
  "name": "@understand-code/artifact-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "default": "./dist/layout.js"
    },
    "./path-guard": {
      "types": "./dist/path-guard.d.ts",
      "import": "./dist/path-guard.js",
      "default": "./dist/path-guard.js"
    },
    "./evidence-adapter": {
      "types": "./dist/evidence-adapter.d.ts",
      "import": "./dist/evidence-adapter.js",
      "default": "./dist/evidence-adapter.js"
    },
    "./committed-strong-task-projection-reader-internal": {
      "types": "./dist/committed-strong-task-projection-reader-internal.d.ts",
      "import": "./dist/committed-strong-task-projection-reader-internal.js",
      "default": "./dist/committed-strong-task-projection-reader-internal.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@understand-code/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
