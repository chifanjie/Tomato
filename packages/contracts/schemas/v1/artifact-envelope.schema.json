{
  "$id": "urn:understand-code:schema:v1:artifact-envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "repository_snapshot",
        "repo_pulse",
        "task_manifest",
        "task_brief",
        "claim_ledger",
        "evidence_ledger",
        "impact",
        "change_check",
        "verification"
      ]
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {}
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
