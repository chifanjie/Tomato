{
  "$id": "urn:understand-code:schema:v1:artifact-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "cold",
        "error"
      ]
    },
    "latestSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descriptorVersion": {
            "type": "number",
            "const": 1
          },
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifactType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "repository_snapshot",
                  "repo_pulse",
                  "task_manifest",
                  "task_brief",
                  "claim_ledger",
                  "evidence_ledger",
                  "impact",
                  "task_operation_journal",
                  "change_check",
                  "verification"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "graph",
                  "graph_meta",
                  "fingerprint",
                  "wiki_index",
                  "wiki_search_index",
                  "wiki_document_traces",
                  "wiki_generation_report",
                  "diff_overlay"
                ]
              },
              {
                "type": "string",
                "const": "task_event_log"
              }
            ]
          },
          "storageFormat": {
            "type": "string",
            "enum": [
              "enveloped_v1",
              "legacy_raw",
              "jsonl_v1"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "schemaVersion": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            ]
          },
          "producerVersion": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "sourceSnapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "taskId": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "current",
              "historical",
              "read_only_recovery",
              "corrupt"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "fresh",
              "partial",
              "stale",
              "invalid"
            ]
          },
          "generatedAt": {
            "type": "string",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
          },
          "legacyFormat": {
            "type": "string",
            "enum": [
              "graph_v1",
              "graph_meta_v1",
              "fingerprint_v1",
              "wiki_v1",
              "wiki_v2",
              "wiki_search_v2",
              "wiki_document_traces_v2",
              "wiki_generation_report_v2",
              "diff_overlay_v1"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "derived_from",
                    "requires",
                    "indexes",
                    "projects"
                  ]
                },
                "requiredDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "requiredSnapshotId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "artifactId",
                "relation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "descriptorVersion",
          "artifactId",
          "artifactType",
          "storageFormat",
          "path",
          "schemaVersion",
          "state",
          "freshness",
          "dependencies"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "repositoryId",
    "worktreeId",
    "status",
    "producerVersion",
    "updatedAt",
    "reasons",
    "artifacts"
  ],
  "additionalProperties": false
}
