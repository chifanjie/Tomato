{
  "$id": "urn:understand-code:schema:v1:check_change-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "actualSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "includeWorktree": {
      "type": "boolean",
      "const": true
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationRecordIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "required": [
    "taskId",
    "includeWorktree",
    "expectedRevision",
    "idempotencyKey",
    "actor"
  ],
  "additionalProperties": false
}
