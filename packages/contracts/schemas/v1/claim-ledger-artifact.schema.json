{
  "$id": "urn:understand-code:schema:v1:claim-ledger-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "claim_ledger"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "taskId": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "goal",
                  "non_goal",
                  "acceptance",
                  "assumption",
                  "recommendation",
                  "risk",
                  "unknown",
                  "finding",
                  "conclusion"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "epistemicStatus": {
                "type": "string",
                "enum": [
                  "observed",
                  "inferred",
                  "unknown",
                  "human_confirmed"
                ]
              },
              "lifecycleStatus": {
                "type": "string",
                "enum": [
                  "draft",
                  "supported",
                  "contested",
                  "invalidated"
                ]
              },
              "freshness": {
                "type": "string",
                "enum": [
                  "current",
                  "changed",
                  "stale",
                  "invalid"
                ]
              },
              "sourceSnapshotId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "findingIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "verificationRecordIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "boundaryReason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "derivationPath": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "evidence"
                        },
                        "evidenceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "required": [
                        "kind",
                        "evidenceId",
                        "description"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "graph_relation"
                        },
                        "relationId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "required": [
                        "kind",
                        "relationId",
                        "description"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "rule"
                        },
                        "ruleId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "required": [
                        "kind",
                        "ruleId",
                        "description"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "assumption"
                        },
                        "claimId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "required": [
                        "kind",
                        "claimId",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "confirmationEventId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "supersedesClaimId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "createdAt": {
                "type": "string",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
              },
              "updatedAt": {
                "type": "string",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
              }
            },
            "required": [
              "id",
              "taskId",
              "kind",
              "statement",
              "epistemicStatus",
              "lifecycleStatus",
              "freshness",
              "sourceSnapshotId",
              "evidenceIds",
              "findingIds",
              "verificationRecordIds",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "claims"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
