{
  "$id": "urn:understand-code:schema:v1:get_task_brief-output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "isError": {
      "type": "boolean",
      "const": false
    },
    "content": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9/])\\/(?!\\/)[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9:/])\\/{2,}[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9])[A-Za-z]:[\\\\/][^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^\\\\])\\\\\\\\[^\\\\\\s\"'`<>{}\\[\\]]+\\\\[^\\\\\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:\\b[Ff][Ii][Ll][Ee]:\\/\\/[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              }
            ]
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "structuredContent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "meta": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "worktreeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sourceSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "headCommit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "worktreeFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "freshness": {
              "type": "string",
              "enum": [
                "not_ready",
                "fresh",
                "partial",
                "stale",
                "unknown",
                "rebuilding",
                "error"
              ]
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "cacheHit": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "truncatedCategories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          },
          "required": [
            "repositoryId",
            "worktreeId",
            "sourceSnapshotId",
            "headCommit",
            "worktreeFingerprint",
            "freshness",
            "durationMs",
            "cacheHit",
            "truncated",
            "truncatedCategories"
          ],
          "additionalProperties": false
        },
        "page": {
          "type": "object",
          "properties": {
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "returned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "nextCursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "required": [
            "pageSize",
            "returned",
            "hasMore"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "task": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "taskId": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "originalIntent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "created",
                    "context_ready",
                    "planned",
                    "in_progress",
                    "check_required",
                    "verification_required",
                    "verified",
                    "blocked",
                    "stale",
                    "superseded"
                  ]
                },
                "parentTaskId": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "repositoryId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "worktreeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "baselineSnapshotId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "latestSnapshotId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "currentChangeCheckId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "currentChangeCheckRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "blockedState": {
                  "type": "object",
                  "properties": {
                    "resumeStatus": {
                      "type": "string",
                      "enum": [
                        "created",
                        "context_ready",
                        "planned",
                        "in_progress",
                        "check_required",
                        "verification_required"
                      ]
                    },
                    "reasonCode": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "actor": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "blockedAt": {
                      "type": "string",
                      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                    }
                  },
                  "required": [
                    "resumeStatus",
                    "reasonCode",
                    "message",
                    "actor",
                    "blockedAt"
                  ],
                  "additionalProperties": false
                },
                "staleState": {
                  "type": "object",
                  "properties": {
                    "staleFromStatus": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "created",
                            "context_ready",
                            "planned",
                            "in_progress",
                            "check_required",
                            "verification_required"
                          ]
                        },
                        {
                          "type": "string",
                          "const": "blocked"
                        }
                      ]
                    },
                    "reasonCodes": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    },
                    "detectedAtSnapshotId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "detectedAt": {
                      "type": "string",
                      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                    }
                  },
                  "required": [
                    "staleFromStatus",
                    "reasonCodes",
                    "detectedAtSnapshotId",
                    "detectedAt"
                  ],
                  "additionalProperties": false
                },
                "supersession": {
                  "type": "object",
                  "properties": {
                    "supersededFromStatus": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "created",
                            "context_ready",
                            "planned",
                            "in_progress",
                            "check_required",
                            "verification_required"
                          ]
                        },
                        {
                          "type": "string",
                          "const": "blocked"
                        },
                        {
                          "type": "string",
                          "const": "stale"
                        }
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "replacementTaskId": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "actor": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "supersededAt": {
                      "type": "string",
                      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                    }
                  },
                  "required": [
                    "supersededFromStatus",
                    "reason",
                    "actor",
                    "supersededAt"
                  ],
                  "additionalProperties": false
                },
                "createdAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                },
                "updatedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                },
                "producerVersion": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "schemaVersion",
                "taskId",
                "title",
                "originalIntent",
                "status",
                "repositoryId",
                "worktreeId",
                "baselineSnapshotId",
                "latestSnapshotId",
                "createdAt",
                "updatedAt",
                "producerVersion",
                "revision"
              ],
              "additionalProperties": false
            },
            "section": {
              "type": "string",
              "enum": [
                "summary",
                "goals",
                "reading_path",
                "planned_changes",
                "assumptions",
                "risks",
                "unknowns",
                "verification_plan"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "claim_reference"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "goal",
                          "non_goal",
                          "acceptance",
                          "assumption",
                          "risk",
                          "unknown"
                        ]
                      },
                      "claimId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "kind",
                      "role",
                      "claimId"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "reading_path"
                      },
                      "entry": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "order": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "file",
                              "symbol",
                              "impact_path"
                            ]
                          },
                          "filePath": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "symbolId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "impactPathId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "claimIds": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          },
                          "evidenceIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          }
                        },
                        "required": [
                          "id",
                          "order",
                          "kind",
                          "claimIds",
                          "evidenceIds"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind",
                      "entry"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "planned_change"
                      },
                      "change": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "candidateLevel": {
                            "type": "string",
                            "enum": [
                              "must_inspect",
                              "likely_change",
                              "possible_change",
                              "test_or_verify",
                              "context_only"
                            ]
                          },
                          "filePath": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "symbolId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "intent": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 16384
                          },
                          "claimIds": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          },
                          "impactPathIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          }
                        },
                        "required": [
                          "id",
                          "candidateLevel",
                          "filePath",
                          "intent",
                          "claimIds",
                          "impactPathIds"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind",
                      "change"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "verification_plan"
                      },
                      "entry": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "acceptanceClaimIds": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          },
                          "method": {
                            "type": "string",
                            "enum": [
                              "test",
                              "build",
                              "lint",
                              "manual",
                              "runtime"
                            ]
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 16384
                          },
                          "required": {
                            "default": true,
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "acceptanceClaimIds",
                          "method",
                          "description",
                          "required"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind",
                      "entry"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "summary"
                      },
                      "originalIntent": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "goalClaimId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "acceptanceClaimCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "plannedChangeCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "originalIntent",
                      "goalClaimId",
                      "acceptanceClaimCount",
                      "plannedChangeCount"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "task",
            "section",
            "items"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "meta",
        "page",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "content",
    "structuredContent"
  ],
  "additionalProperties": false
}
