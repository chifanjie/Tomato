{
  "$id": "urn:understand-code:schema:v1:impact-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "impact"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sourceNodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "targetNodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "classification": {
                "type": "string",
                "enum": [
                  "observed",
                  "inferred",
                  "unknown_boundary"
                ]
              },
              "claimIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "steps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "edgeType": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "upstream",
                        "downstream"
                      ]
                    },
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "exact",
                        "same-file",
                        "imported-package",
                        "heuristic"
                      ]
                    },
                    "provenance": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "filePath": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 16384
                          },
                          "lineNumber": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "confidence": {
                            "type": "string",
                            "enum": [
                              "exact",
                              "same-file",
                              "imported-package"
                            ]
                          },
                          "source": {
                            "type": "string",
                            "const": "static-analysis"
                          }
                        },
                        "required": [
                          "filePath",
                          "lineNumber",
                          "confidence",
                          "source"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "source",
                    "edgeType",
                    "target",
                    "direction"
                  ],
                  "additionalProperties": false
                }
              },
              "boundaryReason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "truncatedAt": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "depth",
                      "node_budget",
                      "unsupported_dynamic_edge"
                    ]
                  },
                  "hiddenCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "sourceNodeId",
              "targetNodeId",
              "classification",
              "claimIds",
              "steps"
            ],
            "additionalProperties": false
          }
        },
        "conclusion": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "paths_observed"
                },
                "impactPathIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "boundaryEvidenceIds": {
                  "type": "array",
                  "items": false,
                  "minItems": 0,
                  "maxItems": 0
                }
              },
              "required": [
                "status",
                "impactPathIds",
                "boundaryEvidenceIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "none_observed"
                },
                "impactPathIds": {
                  "type": "array",
                  "items": false,
                  "minItems": 0,
                  "maxItems": 0
                },
                "boundaryEvidenceIds": {
                  "type": "array",
                  "items": false,
                  "minItems": 0,
                  "maxItems": 0
                }
              },
              "required": [
                "status",
                "impactPathIds",
                "boundaryEvidenceIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "partial"
                },
                "impactPathIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "boundaryEvidenceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^boundary-evidence:[0-9a-f]{22}$"
                  }
                }
              },
              "required": [
                "status",
                "impactPathIds",
                "boundaryEvidenceIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "unknown"
                },
                "impactPathIds": {
                  "type": "array",
                  "items": false,
                  "minItems": 0,
                  "maxItems": 0
                },
                "boundaryEvidenceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^boundary-evidence:[0-9a-f]{22}$"
                  }
                }
              },
              "required": [
                "status",
                "impactPathIds",
                "boundaryEvidenceIds"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "paths"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
