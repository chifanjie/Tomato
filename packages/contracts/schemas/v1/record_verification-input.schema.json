{
  "$id": "urn:understand-code:schema:v1:record_verification-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "record": {
      "type": "object",
      "properties": {
        "verificationPlanEntryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "supersedesVerificationRecordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "test",
            "build",
            "lint",
            "manual",
            "runtime"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "blocked",
            "flaky"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "verificationPlanEntryId",
        "kind",
        "status",
        "summary",
        "claimIds",
        "snapshotId"
      ],
      "additionalProperties": false
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "taskId",
    "record",
    "expectedRevision",
    "idempotencyKey",
    "actor"
  ],
  "additionalProperties": false
}
