            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9/])\\/(?!\\/)[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9:/])\\/{2,}[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9])[A-Za-z]:[\\\\/][^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*(?:(?:^|[^\\\\])\\\\\\\\[^\\\\\\s\"'`<>{}\\[\\]]+\\\\[^\\\\\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
                  },
                  {
                    "pattern": "^(?![\\s\\S]*(?:\\b[Ff][Ii][Ll][Ee]:\\/\\/[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
                  }
                ]
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "structuredContent": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "meta": {
              "type": "object",
              "properties": {
                "repositoryId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "worktreeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sourceSnapshotId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "headCommit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "worktreeFingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "freshness": {
                  "type": "string",
                  "enum": [
                    "not_ready",
                    "fresh",
                    "partial",
                    "stale",
                    "unknown",
                    "rebuilding",
                    "error"
                  ]
                },
                "durationMs": {
                  "type": "number",
                  "minimum": 0
                },
                "cacheHit": {
                  "type": "boolean"
                },
                "truncated": {
                  "type": "boolean"
                },
                "truncatedCategories": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  }
                }
              },
              "required": [
                "repositoryId",
                "worktreeId",
                "sourceSnapshotId",
                "headCommit",
                "worktreeFingerprint",
                "freshness",
                "durationMs",
                "cacheHit",
                "truncated",
                "truncatedCategories"
              ],
              "additionalProperties": false
