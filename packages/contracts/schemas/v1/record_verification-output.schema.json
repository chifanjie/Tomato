{
  "$id": "urn:understand-code:schema:v1:record_verification-output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "isError": {
          "type": "boolean",
          "const": false
