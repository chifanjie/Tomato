                    },
                    "verificationPlanEntryId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "attempt": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "supersedesVerificationRecordId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "test",
                        "build",
                        "lint",
                        "manual",
                        "runtime"
                      ]
