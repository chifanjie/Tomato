                    "snapshotId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "skipAcceptance": {
                      "type": "object",
                      "properties": {
                        "actor": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        },
                        "acceptedAt": {
                          "type": "string",
                          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                        },
                        "eventId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [
                        "actor",
                        "reason",
                        "acceptedAt",
                        "eventId"
