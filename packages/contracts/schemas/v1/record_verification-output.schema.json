{
  "$id": "urn:understand-code:schema:v1:record_verification-output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "isError": {
      "type": "boolean",
      "const": false
    },
    "content": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "structuredContent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "meta": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "worktreeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sourceSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "headCommit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "worktreeFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "freshness": {
              "type": "string",
              "enum": [
                "not_ready",
                "fresh",
                "partial",
                "stale",
                "unknown",
                "rebuilding",
                "error"
              ]
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "cacheHit": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "truncatedCategories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          },
          "required": [
            "repositoryId",
            "worktreeId",
            "sourceSnapshotId",
            "headCommit",
            "worktreeFingerprint",
            "freshness",
            "durationMs",
            "cacheHit",
            "truncated",
            "truncatedCategories"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "verification": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "taskId": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "verificationPlanEntryId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "attempt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "supersedesVerificationRecordId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "test",
                    "build",
                    "lint",
                    "manual",
                    "runtime"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "skipped",
                    "blocked",
                    "flaky"
                  ]
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "exitCode": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outputDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "snapshotId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "skipAcceptance": {
                  "type": "object",
                  "properties": {
                    "actor": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "acceptedAt": {
                      "type": "string",
                      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                    },
                    "eventId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "actor",
                    "reason",
                    "acceptedAt",
                    "eventId"
                  ],
                  "additionalProperties": false
                },
                "recordedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                },
                "actor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "id",
                "taskId",
                "verificationPlanEntryId",
                "attempt",
                "kind",
                "status",
                "summary",
                "claimIds",
                "snapshotId",
                "recordedAt",
                "actor"
              ],
              "additionalProperties": false
            },
            "mutation": {
              "type": "object",
              "properties": {
                "taskId": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "eventId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "artifactIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "idempotentReplay": {
                  "type": "boolean"
                }
              },
              "required": [
                "taskId",
                "revision",
                "eventId",
                "artifactIds",
                "idempotentReplay"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "verification",
            "mutation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "meta",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "content",
    "structuredContent"
  ],
  "additionalProperties": false
}
