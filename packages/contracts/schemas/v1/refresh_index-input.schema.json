{
  "$id": "urn:understand-code:schema:v1:refresh_index-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "incremental",
        "full"
      ]
    },
    "expectedSourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "knowledge": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "stage"
            },
            "taskId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "expectedTaskRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "action",
            "taskId",
            "expectedTaskRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "publish"
            },
            "taskId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "expectedTaskRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "candidateGenerationId": {
              "type": "string",
              "pattern": "^generation-[0-9a-f]{64}$"
            }
          },
          "required": [
            "action",
            "taskId",
            "expectedTaskRevision",
            "candidateGenerationId"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "mode",
    "idempotencyKey",
    "actor"
  ],
  "additionalProperties": false
}
