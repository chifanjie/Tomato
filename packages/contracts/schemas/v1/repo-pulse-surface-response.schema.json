{
  "$id": "urn:understand-code:schema:v1:repo-pulse-surface-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "viewVersion": {
          "type": "number",
          "const": 1
        },
        "viewKind": {
          "type": "string",
          "const": "legacy_repo_pulse_redacted"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_ready",
            "fresh",
            "partial",
            "stale",
            "unknown",
            "rebuilding",
            "error"
          ]
        },
        "aggregateChangeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
        },
        "strongOperationSupported": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "viewVersion",
        "viewKind",
        "status",
        "evaluatedAt",
        "strongOperationSupported"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "viewVersion": {
          "type": "number",
          "const": 1
        },
        "viewKind": {
          "type": "string",
          "const": "strong_repo_pulse"
        },
        "evaluatedSnapshotId": {
          "type": "string",
          "pattern": "^snapshot-[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_ready",
            "fresh",
            "partial",
            "stale",
            "unknown",
            "rebuilding",
            "error"
          ]
        },
        "branchState": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "detached"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "safe"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "status",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "redacted"
                },
                "boundaryCode": {
                  "type": "string",
                  "enum": [
                    "sensitive_path",
                    "secret_content",
                    "invalid_utf8",
                    "control_character",
                    "branch_value_oversized",
                    "unsafe_git_ref"
                  ]
                }
              },
              "required": [
                "status",
                "boundaryCode"
              ],
              "additionalProperties": false
            }
          ]
        },
        "safeChangeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "redactedChangeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownStateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "redactionBoundaryCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hard_deny_path",
              "sensitive_path",
              "secret_content",
              "invalid_utf8",
              "control_character",
              "branch_value_oversized",
              "unsafe_git_ref",
              "scan_unit_oversized",
              "scan_capture_limit",
              "unstable_read",
              "unrepresentable_path",
              "unsafe_file_kind"
            ]
          }
        },
        "uncertaintyCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hard_deny_equality_unprovable",
              "scan_unit_limit_equality_unprovable",
              "scan_capture_limit_equality_unprovable",
              "unstable_read",
              "unreadable",
              "unrepresentable_path",
              "unsafe_file_kind"
            ]
          }
        },
        "evaluatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
        },
        "strongOperationSupported": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "viewVersion",
        "viewKind",
        "evaluatedSnapshotId",
        "status",
        "branchState",
        "safeChangeCount",
        "redactedChangeCount",
        "unknownStateCount",
        "redactionBoundaryCodes",
        "uncertaintyCodes",
        "evaluatedAt",
        "strongOperationSupported"
      ],
      "additionalProperties": false
    }
  ]
}
