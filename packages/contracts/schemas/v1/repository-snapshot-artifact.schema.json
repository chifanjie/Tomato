{
  "$id": "urn:understand-code:schema:v1:repository-snapshot-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "repository_snapshot"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "snapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "worktreeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "rootIdentity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "headCommit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "baseCommit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "mergeBase": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "indexDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "worktreeDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "untrackedDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "ignoreDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "createdAt": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
            },
            "captureStatus": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "error"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "oldPath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "committed",
                      "staged",
                      "unstaged",
                      "untracked",
                      "conflict"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "added",
                      "modified",
                      "deleted",
                      "renamed",
                      "copied",
                      "type_changed"
                    ]
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "previousContentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "id",
                  "path",
                  "source",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "snapshotId",
            "repositoryId",
            "worktreeId",
            "rootIdentity",
            "indexDigest",
            "worktreeDigest",
            "untrackedDigest",
            "ignoreDigest",
            "createdAt",
            "captureStatus",
            "limitations",
            "changes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "profile": {
              "type": "string",
              "const": "repository_snapshot_path_safe_v1"
            },
            "snapshotId": {
              "type": "string",
              "pattern": "^snapshot-[0-9a-f]{64}$"
            },
            "repositoryId": {
              "type": "string",
              "pattern": "^repo-hmac-[0-9a-f]{64}$"
            },
            "worktreeId": {
              "type": "string",
              "pattern": "^worktree-hmac-[0-9a-f]{64}$"
            },
            "rootIdentity": {
              "type": "string",
              "pattern": "^root-hmac-[0-9a-f]{64}$"
            },
            "branchState": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "detached"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "safe"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    }
                  },
                  "required": [
                    "status",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "redacted"
                    },
                    "boundaryCode": {
                      "type": "string",
                      "enum": [
                        "sensitive_path",
                        "secret_content",
                        "invalid_utf8",
                        "control_character",
                        "branch_value_oversized",
                        "unsafe_git_ref"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "boundaryCode"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "objectFormat": {
              "type": "string",
              "enum": [
                "sha1",
                "sha256"
              ]
            },
            "headState": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "commit"
                    },
                    "commit": {
                      "type": "string",
                      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                    }
                  },
                  "required": [
                    "kind",
                    "commit"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "unborn"
                    },
                    "emptyTreeObjectId": {
                      "type": "string",
                      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                    }
                  },
                  "required": [
                    "kind",
                    "emptyTreeObjectId"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "baseCommit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "mergeBase": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "repositoryStateToken": {
              "type": "string",
              "pattern": "^hmac-sha256:[0-9a-f]{64}$"
            },
            "indexToken": {
              "type": "string",
              "pattern": "^hmac-sha256:[0-9a-f]{64}$"
            },
            "worktreeToken": {
              "type": "string",
              "pattern": "^hmac-sha256:[0-9a-f]{64}$"
            },
            "untrackedToken": {
              "type": "string",
              "pattern": "^hmac-sha256:[0-9a-f]{64}$"
            },
            "ignoreToken": {
              "type": "string",
              "pattern": "^hmac-sha256:[0-9a-f]{64}$"
            },
            "securityScanPolicyDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "safeGitExecutionDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "createdAt": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
            },
            "captureStatus": {
              "type": "string",
              "enum": [
                "complete",
                "partial"
              ]
            },
            "accounting": {
              "type": "object",
              "properties": {
                "rawLayerUnitCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "candidateUnitCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "safeChangeCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "redactedKnownChangeCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unknownStateCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "rawLayerUnitCount",
                "candidateUnitCount",
                "safeChangeCount",
                "redactedKnownChangeCount",
                "unknownStateCount"
              ],
              "additionalProperties": false
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^change-[0-9a-f]{64}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "oldPath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "committed",
                      "staged",
                      "unstaged",
                      "untracked",
                      "conflict"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "added",
                      "modified",
                      "deleted",
                      "renamed",
                      "copied",
                      "type_changed"
                    ]
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "previousContentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "id",
                  "path",
                  "source",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "redactedChanges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^snapshot-redaction-[0-9a-f]{64}$"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "committed",
                      "staged",
                      "unstaged",
                      "untracked",
                      "conflict"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "added",
                      "modified",
                      "deleted",
                      "renamed",
                      "copied",
                      "type_changed"
                    ]
                  },
                  "boundaryCode": {
                    "type": "string",
                    "enum": [
                      "hard_deny_path",
                      "sensitive_path",
                      "secret_content",
                      "invalid_utf8",
                      "control_character",
                      "branch_value_oversized",
                      "unsafe_git_ref",
                      "scan_unit_oversized",
                      "scan_capture_limit",
                      "unstable_read",
                      "unrepresentable_path",
                      "unsafe_file_kind"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "source",
                  "kind",
                  "boundaryCode",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "unknownStates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^snapshot-unknown-state-[0-9a-f]{64}$"
                  },
                  "code": {
                    "type": "string",
                    "enum": [
                      "hard_deny_equality_unprovable",
                      "scan_unit_limit_equality_unprovable",
                      "scan_capture_limit_equality_unprovable",
                      "unstable_read",
                      "unreadable",
                      "unrepresentable_path",
                      "unsafe_file_kind"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "code",
                  "count"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "profile",
            "snapshotId",
            "repositoryId",
            "worktreeId",
            "rootIdentity",
            "branchState",
            "objectFormat",
            "headState",
            "repositoryStateToken",
            "indexToken",
            "worktreeToken",
            "untrackedToken",
            "ignoreToken",
            "securityScanPolicyDigest",
            "safeGitExecutionDigest",
            "createdAt",
            "captureStatus",
            "accounting",
            "changes",
            "redactedChanges",
            "unknownStates"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
