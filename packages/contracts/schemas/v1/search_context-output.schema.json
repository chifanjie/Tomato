{
  "$id": "urn:understand-code:schema:v1:search_context-output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "isError": {
      "type": "boolean",
      "const": false
    },
    "content": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "structuredContent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "meta": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "worktreeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sourceSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "headCommit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "worktreeFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "freshness": {
              "type": "string",
              "enum": [
                "not_ready",
                "fresh",
                "partial",
                "stale",
                "unknown",
                "rebuilding",
                "error"
              ]
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "cacheHit": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "truncatedCategories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          },
          "required": [
            "repositoryId",
            "worktreeId",
            "sourceSnapshotId",
            "headCommit",
            "worktreeFingerprint",
            "freshness",
            "durationMs",
            "cacheHit",
            "truncated",
            "truncatedCategories"
          ],
          "additionalProperties": false
        },
        "page": {
          "type": "object",
          "properties": {
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "returned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "nextCursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "required": [
            "pageSize",
            "returned",
            "hasMore"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "score": {
                        "type": "number"
                      },
                      "reasons": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "evidenceIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "kind": {
                        "type": "string",
                        "const": "file"
                      },
                      "filePath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "summary",
                      "score",
                      "reasons",
                      "evidenceIds",
                      "kind",
                      "filePath"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "score": {
                        "type": "number"
                      },
                      "reasons": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "evidenceIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "kind": {
                        "type": "string",
                        "const": "symbol"
                      },
                      "symbolId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "filePath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "summary",
                      "score",
                      "reasons",
                      "evidenceIds",
                      "kind",
                      "symbolId",
                      "filePath"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "score": {
                        "type": "number"
                      },
                      "reasons": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "evidenceIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "kind": {
                        "type": "string",
                        "const": "wiki"
                      },
                      "documentId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "summary",
                      "score",
                      "reasons",
                      "evidenceIds",
                      "kind",
                      "documentId"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "score": {
                        "type": "number"
                      },
                      "reasons": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        }
                      },
                      "evidenceIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "kind": {
                        "type": "string",
                        "const": "graph"
                      },
                      "nodeId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "summary",
                      "score",
                      "reasons",
                      "evidenceIds",
                      "kind",
                      "nodeId"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "results"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "meta",
        "page",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "content",
    "structuredContent"
  ],
  "additionalProperties": false
}
