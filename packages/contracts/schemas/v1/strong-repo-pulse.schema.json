{
  "$id": "urn:understand-code:schema:v1:strong-repo-pulse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "repo_pulse_path_safe_v1"
    },
    "evaluatedSnapshotId": {
      "type": "string",
      "pattern": "^snapshot-[0-9a-f]{64}$"
    },
    "evaluatedSnapshotContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baselineSnapshotId": {
      "type": "string",
      "pattern": "^snapshot-[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_ready",
        "fresh",
        "partial",
        "stale",
        "unknown",
        "rebuilding",
        "error"
      ]
    },
    "artifactFreshness": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string",
          "enum": [
            "fresh",
            "partial",
            "stale",
            "missing",
            "error"
          ]
        },
        "wiki": {
          "type": "string",
          "enum": [
            "fresh",
            "partial",
            "stale",
            "missing",
            "error"
          ]
        },
        "evidence": {
          "type": "string",
          "enum": [
            "fresh",
            "partial",
            "stale",
            "missing",
            "error"
          ]
        },
        "diff": {
          "type": "string",
          "enum": [
            "fresh",
            "partial",
            "stale",
            "missing",
            "error"
          ]
        },
        "task": {
          "type": "string",
          "enum": [
            "fresh",
            "partial",
            "stale",
            "missing",
            "error"
          ]
        }
      },
      "required": [
        "graph",
        "wiki",
        "evidence",
        "diff",
        "task"
      ],
      "additionalProperties": false
    },
    "repositoryState": {
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^repo-hmac-[0-9a-f]{64}$"
        },
        "worktreeId": {
          "type": "string",
          "pattern": "^worktree-hmac-[0-9a-f]{64}$"
        },
        "rootIdentity": {
          "type": "string",
          "pattern": "^root-hmac-[0-9a-f]{64}$"
        },
        "branchState": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "detached"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "safe"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "status",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "redacted"
                },
                "boundaryCode": {
                  "type": "string",
                  "enum": [
                    "sensitive_path",
                    "secret_content",
                    "invalid_utf8",
                    "control_character",
                    "branch_value_oversized",
                    "unsafe_git_ref"
                  ]
                }
              },
              "required": [
                "status",
                "boundaryCode"
              ],
              "additionalProperties": false
            }
          ]
        },
        "objectFormat": {
          "type": "string",
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "headState": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "commit"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "kind",
                "commit"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "unborn"
                },
                "emptyTreeObjectId": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "kind",
                "emptyTreeObjectId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "repositoryStateToken": {
          "type": "string",
          "pattern": "^hmac-sha256:[0-9a-f]{64}$"
        },
        "captureStatus": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        }
      },
      "required": [
        "repositoryId",
        "worktreeId",
        "rootIdentity",
        "branchState",
        "objectFormat",
        "headState",
        "repositoryStateToken",
        "captureStatus"
      ],
      "additionalProperties": false
    },
    "changeSummary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bySource": {
          "type": "object",
          "properties": {
            "committed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "staged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unstaged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "untracked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "conflict": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "committed",
            "staged",
            "unstaged",
            "untracked",
            "conflict"
          ],
          "additionalProperties": false
        },
        "byKind": {
          "type": "object",
          "properties": {
            "added": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "modified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deleted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "renamed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "copied": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type_changed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied",
            "type_changed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "total",
        "bySource",
        "byKind"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "snapshotProfile": {
          "type": "string",
          "const": "repository_snapshot_path_safe_v1"
        },
        "safeChangeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "redactedChangeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownStateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "redactionBoundaryCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hard_deny_path",
              "sensitive_path",
              "secret_content",
              "invalid_utf8",
              "control_character",
              "branch_value_oversized",
              "unsafe_git_ref",
              "scan_unit_oversized",
              "scan_capture_limit",
              "unstable_read",
              "unrepresentable_path",
              "unsafe_file_kind"
            ]
          }
        },
        "uncertaintyCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hard_deny_equality_unprovable",
              "scan_unit_limit_equality_unprovable",
              "scan_capture_limit_equality_unprovable",
              "unstable_read",
              "unreadable",
              "unrepresentable_path",
              "unsafe_file_kind"
            ]
          }
        }
      },
      "required": [
        "snapshotProfile",
        "safeChangeCount",
        "redactedChangeCount",
        "unknownStateCount",
        "redactionBoundaryCodes",
        "uncertaintyCodes"
      ],
      "additionalProperties": false
    },
    "securityScanPolicyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeGitExecutionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completeness": {
      "type": "object",
      "properties": {
        "parser": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "unknown",
                "unsupported"
              ]
            },
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "repository_capture_partial",
                  "repository_branch_redacted",
                  "repository_security_boundary",
                  "artifact_missing",
                  "artifact_stale",
                  "parser_partial",
                  "parser_unsupported",
                  "call_graph_partial",
                  "strong_refresh_required"
                ]
              }
            }
          },
          "required": [
            "status",
            "reasonCodes"
          ],
          "additionalProperties": false
        },
        "callGraph": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "unknown",
                "unsupported"
              ]
            },
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "repository_capture_partial",
                  "repository_branch_redacted",
                  "repository_security_boundary",
                  "artifact_missing",
                  "artifact_stale",
                  "parser_partial",
                  "parser_unsupported",
                  "call_graph_partial",
                  "strong_refresh_required"
                ]
              }
            }
          },
          "required": [
            "status",
            "reasonCodes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "parser",
        "callGraph"
      ],
      "additionalProperties": false
    },
    "recommendedRefresh": {
      "type": "string",
      "enum": [
        "none",
        "incremental",
        "full"
      ]
    },
    "diagnosticCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "repository_capture_partial",
          "repository_branch_redacted",
          "repository_security_boundary",
          "artifact_missing",
          "artifact_stale",
          "parser_partial",
          "parser_unsupported",
          "call_graph_partial",
          "strong_refresh_required"
        ]
      }
    },
    "evaluatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    }
  },
  "required": [
    "profile",
    "evaluatedSnapshotId",
    "evaluatedSnapshotContentDigest",
    "status",
    "artifactFreshness",
    "repositoryState",
    "changeSummary",
    "security",
    "securityScanPolicyDigest",
    "safeGitExecutionDigest",
    "completeness",
    "recommendedRefresh",
    "diagnosticCodes",
    "evaluatedAt"
  ],
  "additionalProperties": false
}
