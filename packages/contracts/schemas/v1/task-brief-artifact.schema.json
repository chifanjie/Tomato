{
  "$id": "urn:understand-code:schema:v1:task-brief-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "task_brief"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "originalIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "goalClaimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nonGoalClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "acceptanceClaimIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "readingPath": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "symbol",
                  "impact_path"
                ]
              },
              "filePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "symbolId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "impactPathId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "claimIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "required": [
              "id",
              "order",
              "kind",
              "claimIds",
              "evidenceIds"
            ],
            "additionalProperties": false
          }
        },
        "plannedChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "expectation": {
                "type": "string",
                "enum": [
                  "required_change",
                  "optional_change",
                  "inspect_only",
                  "verification_only"
                ]
              },
              "candidateLevel": {
                "type": "string",
                "enum": [
                  "must_inspect",
                  "likely_change",
                  "possible_change",
                  "test_or_verify",
                  "context_only"
                ]
              },
              "filePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "symbolId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "intent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "claimIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "impactPathIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "required": [
              "id",
              "candidateLevel",
              "filePath",
              "intent",
              "claimIds",
              "impactPathIds"
            ],
            "additionalProperties": false
          }
        },
        "assumptionClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "riskClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "unknownClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "verificationPlan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "acceptanceClaimIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "method": {
                "type": "string",
                "enum": [
                  "test",
                  "build",
                  "lint",
                  "manual",
                  "runtime"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "acceptanceClaimIds",
              "method",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "originalIntent",
        "goalClaimId",
        "nonGoalClaimIds",
        "acceptanceClaimIds",
        "readingPath",
        "plannedChanges",
        "assumptionClaimIds",
        "riskClaimIds",
        "unknownClaimIds",
        "verificationPlan"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
