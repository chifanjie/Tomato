{
  "$id": "urn:understand-code:schema:v1:task-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "previousRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "occurredAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "previousStatus": {
      "type": "string",
      "enum": [
        "created",
        "context_ready",
        "planned",
        "in_progress",
        "check_required",
        "verification_required",
        "verified",
        "blocked",
        "stale",
        "superseded"
      ]
    },
    "resultingStatus": {
      "type": "string",
      "enum": [
        "created",
        "context_ready",
        "planned",
        "in_progress",
        "check_required",
        "verification_required",
        "verified",
        "blocked",
        "stale",
        "superseded"
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "confirm_goal"
            },
            "claimId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "claimId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "confirm_acceptance_criteria"
            },
            "claimIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "required": [
            "type",
            "claimIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "confirm_plan"
            },
            "plannedChangeIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "required": [
            "type",
            "plannedChangeIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "record_assumption"
            },
            "claimId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "claimId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "confirm_unknown"
            },
            "claimId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "claimId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "transition_status"
            },
            "to": {
              "type": "string",
              "enum": [
                "context_ready",
                "planned",
                "in_progress",
                "check_required",
                "verification_required",
                "verified"
              ]
            },
            "verificationRecordId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "accept_finding"
            },
            "findingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "type",
            "findingId",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "block_task"
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "type",
            "reasonCode",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "resume_task"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "refresh_task_context"
            },
            "targetSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "targetSnapshotId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rebase_task"
            },
            "targetSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "newBaselineSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "type",
            "targetSnapshotId",
            "newBaselineSnapshotId",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "supersede_task"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "replacementTaskId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "accept_verification_skip"
            },
            "verificationRecordId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "type",
            "verificationRecordId",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "task_created"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "change_checked"
            },
            "changeCheckArtifactId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "changeCheckId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "changeCheckArtifactId",
            "changeCheckId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "verification_recorded"
            },
            "verificationRecordId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "verificationRecordId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "task_context_staled"
            },
            "reasonCodes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            },
            "detectedAtSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "reasonCodes",
            "detectedAtSnapshotId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "previousEventDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eventDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "repositoryId",
    "worktreeId",
    "taskId",
    "previousRevision",
    "revision",
    "actor",
    "idempotencyKey",
    "requestDigest",
    "occurredAt",
    "resultingStatus",
    "action",
    "eventDigest"
  ],
  "additionalProperties": false
}
