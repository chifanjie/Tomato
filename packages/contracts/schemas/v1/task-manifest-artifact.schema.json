{
  "$id": "urn:understand-code:schema:v1:task-manifest-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "task_manifest"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "taskId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "originalIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "context_ready",
            "planned",
            "in_progress",
            "check_required",
            "verification_required",
            "verified",
            "blocked",
            "stale",
            "superseded"
          ]
        },
        "parentTaskId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "worktreeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baselineSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "latestSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "currentChangeCheckId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "currentChangeCheckRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockedState": {
          "type": "object",
          "properties": {
            "resumeStatus": {
              "type": "string",
              "enum": [
                "created",
                "context_ready",
                "planned",
                "in_progress",
                "check_required",
                "verification_required"
              ]
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "actor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "blockedAt": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
            }
          },
          "required": [
            "resumeStatus",
            "reasonCode",
            "message",
            "actor",
            "blockedAt"
          ],
          "additionalProperties": false
        },
        "staleState": {
          "type": "object",
          "properties": {
            "staleFromStatus": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "created",
                    "context_ready",
                    "planned",
                    "in_progress",
                    "check_required",
                    "verification_required"
                  ]
                },
                {
                  "type": "string",
                  "const": "blocked"
                }
              ]
            },
            "reasonCodes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            },
            "detectedAtSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "detectedAt": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
            }
          },
          "required": [
            "staleFromStatus",
            "reasonCodes",
            "detectedAtSnapshotId",
            "detectedAt"
          ],
          "additionalProperties": false
        },
        "supersession": {
          "type": "object",
          "properties": {
            "supersededFromStatus": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "created",
                    "context_ready",
                    "planned",
                    "in_progress",
                    "check_required",
                    "verification_required"
                  ]
                },
                {
                  "type": "string",
                  "const": "blocked"
                },
                {
                  "type": "string",
                  "const": "stale"
                }
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "replacementTaskId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "actor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "supersededAt": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
            }
          },
          "required": [
            "supersededFromStatus",
            "reason",
            "actor",
            "supersededAt"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
        },
        "producerVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "taskId",
        "title",
        "originalIntent",
        "status",
        "repositoryId",
        "worktreeId",
        "baselineSnapshotId",
        "latestSnapshotId",
        "createdAt",
        "updatedAt",
        "producerVersion",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
