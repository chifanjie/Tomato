{
  "$id": "urn:understand-code:schema:v1:trace_impact-output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "isError": {
      "type": "boolean",
      "const": false
    },
    "content": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9/])\\/(?!\\/)[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9:/])\\/{2,}[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^A-Za-z0-9])[A-Za-z]:[\\\\/][^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:(?:^|[^\\\\])\\\\\\\\[^\\\\\\s\"'`<>{}\\[\\]]+\\\\[^\\\\\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              },
              {
                "pattern": "^(?![\\s\\S]*(?:\\b[Ff][Ii][Ll][Ee]:\\/\\/[^\\s\"'`<>{}\\[\\]]+))[\\s\\S]*$"
              }
            ]
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "structuredContent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "meta": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "worktreeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sourceSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "headCommit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "worktreeFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "freshness": {
              "type": "string",
              "enum": [
                "not_ready",
                "fresh",
                "partial",
                "stale",
                "unknown",
                "rebuilding",
                "error"
              ]
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "cacheHit": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "truncatedCategories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          },
          "required": [
            "repositoryId",
            "worktreeId",
            "sourceSnapshotId",
            "headCommit",
            "worktreeFingerprint",
            "freshness",
            "durationMs",
            "cacheHit",
            "truncated",
            "truncatedCategories"
          ],
          "additionalProperties": false
        },
        "page": {
          "type": "object",
          "properties": {
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "returned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "nextCursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "required": [
            "pageSize",
            "returned",
            "hasMore"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "sourceNodeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "targetNodeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "classification": {
                    "type": "string",
                    "enum": [
                      "observed",
                      "inferred",
                      "unknown_boundary"
                    ]
                  },
                  "claimIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "steps": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "edgeType": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384
                        },
                        "target": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "upstream",
                            "downstream"
                          ]
                        },
                        "evidenceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "exact",
                            "same-file",
                            "imported-package",
                            "heuristic"
                          ]
                        },
                        "provenance": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "filePath": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 16384
                              },
                              "lineNumber": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "confidence": {
                                "type": "string",
                                "enum": [
                                  "exact",
                                  "same-file",
                                  "imported-package"
                                ]
                              },
                              "source": {
                                "type": "string",
                                "const": "static-analysis"
                              }
                            },
                            "required": [
                              "filePath",
                              "lineNumber",
                              "confidence",
                              "source"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "source",
                        "edgeType",
                        "target",
                        "direction"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "boundaryReason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "truncatedAt": {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": "string",
                        "enum": [
                          "depth",
                          "node_budget",
                          "unsupported_dynamic_edge"
                        ]
                      },
                      "hiddenCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "sourceNodeId",
                  "targetNodeId",
                  "classification",
                  "claimIds",
                  "steps"
                ],
                "additionalProperties": false
              }
            },
            "unresolvedNodeIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "required": [
            "paths",
            "unresolvedNodeIds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "meta",
        "page",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "content",
    "structuredContent"
  ],
  "additionalProperties": false
}
