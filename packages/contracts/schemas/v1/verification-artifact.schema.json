{
  "$id": "urn:understand-code:schema:v1:verification-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "verification"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "taskId": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "verificationPlanEntryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "attempt": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "supersedesVerificationRecordId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "enum": [
                  "test",
                  "build",
                  "lint",
                  "manual",
                  "runtime"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "blocked",
                  "flaky"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "exitCode": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "snapshotId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "skipAcceptance": {
                "type": "object",
                "properties": {
                  "actor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "acceptedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                  },
                  "eventId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "actor",
                  "reason",
                  "acceptedAt",
                  "eventId"
                ],
                "additionalProperties": false
              },
              "recordedAt": {
                "type": "string",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
              },
              "actor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "id",
              "taskId",
              "verificationPlanEntryId",
              "attempt",
              "kind",
              "status",
              "summary",
              "claimIds",
              "snapshotId",
              "recordedAt",
              "actor"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "records"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
