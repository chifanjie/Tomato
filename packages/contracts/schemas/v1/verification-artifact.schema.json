{
  "$id": "urn:understand-code:schema:v1:verification-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "verification"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "worktreeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "taskId": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "verificationPlanEntryId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "attempt": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "supersedesVerificationRecordId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "test",
                      "build",
                      "lint",
                      "manual",
                      "runtime"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "skipped",
                      "blocked",
                      "flaky"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "exitCode": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "outputDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "claimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "snapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "skipAcceptance": {
                    "type": "object",
                    "properties": {
                      "actor": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "acceptedAt": {
                        "type": "string",
                        "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                      },
                      "eventId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "actor",
                      "reason",
                      "acceptedAt",
                      "eventId"
                    ],
                    "additionalProperties": false
                  },
                  "recordedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                  },
                  "actor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "id",
                  "taskId",
                  "verificationPlanEntryId",
                  "attempt",
                  "kind",
                  "status",
                  "summary",
                  "claimIds",
                  "snapshotId",
                  "recordedAt",
                  "actor"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "records"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "verification_ledger_strong_v1"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "profile": {
                    "type": "string",
                    "const": "verification_record_strong_v1"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^verification-record:[0-9a-f]{22}$"
                  },
                  "taskId": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "verificationPlanEntryId": {
                    "type": "string",
                    "pattern": "^verification-plan:[0-9a-f]{22}$"
                  },
                  "contextGenerationId": {
                    "type": "string",
                    "pattern": "^context-generation:[0-9a-f]{22}$"
                  },
                  "attempt": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "supersedesVerificationRecordId": {
                    "type": "string",
                    "pattern": "^verification-record:[0-9a-f]{22}$"
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "test",
                      "build",
                      "lint",
                      "manual",
                      "runtime"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "skipped",
                      "blocked",
                      "flaky"
                    ]
                  },
                  "publicResultCode": {
                    "type": "string",
                    "enum": [
                      "verification_passed",
                      "verification_failed",
                      "verification_blocked",
                      "verification_flaky",
                      "verification_skipped"
                    ]
                  },
                  "claimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "snapshotId": {
                    "type": "string",
                    "pattern": "^snapshot-[0-9a-f]{64}$"
                  },
                  "changeCheckArtifactId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "changeCheckContentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "detail": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "const": "none"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "const": "stored"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "const": "redacted"
                          },
                          "redactionCodes": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "secret_detected",
                                "host_path_detected",
                                "control_character",
                                "invalid_utf8"
                              ]
                            }
                          }
                        },
                        "required": [
                          "status",
                          "redactionCodes"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "recordedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
                  }
                },
                "required": [
                  "profile",
                  "id",
                  "taskId",
                  "verificationPlanEntryId",
                  "contextGenerationId",
                  "attempt",
                  "method",
                  "status",
                  "publicResultCode",
                  "claimIds",
                  "snapshotId",
                  "changeCheckArtifactId",
                  "changeCheckContentDigest",
                  "detail",
                  "recordedAt"
                ],
                "additionalProperties": false
              }
            },
            "skipAcceptances": {
              "type": "array",
              "items": false,
              "minItems": 0,
              "maxItems": 0
            }
          },
          "required": [
            "profile",
            "records",
            "skipAcceptances"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "repositoryId",
    "worktreeId",
    "sourceSnapshotId",
    "revision",
    "producerVersion",
    "createdAt",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
