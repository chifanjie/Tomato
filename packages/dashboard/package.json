{
  "name": "@understand-code/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:surface": "node scripts/audit-active-surface.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --config vite.config.demo.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:artifacts": "pnpm --filter @understand-code/core build && node scripts/verify-artifacts.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@understand-code/core": "workspace:*",
    "@xyflow/react": "^12.0.0",
    "devlop": "^1.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "20.10.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.2",
    "vitest": "^3.1.0"
  }
}
