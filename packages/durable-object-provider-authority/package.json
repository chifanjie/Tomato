{
  "name": "@understand-code/durable-object-provider-authority",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "understand-code-provider-acceptance-authority": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/acceptance-store": {
      "types": "./dist/acceptance-store-internal.d.ts",
      "import": "./dist/acceptance-store-internal.js",
      "default": "./dist/acceptance-store-internal.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@understand-code/durable-object-provider-contracts": "workspace:*",
    "@understand-code/durable-object-provider-runtime": "workspace:*",
    "@understand-code/native-kernel-bridge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
