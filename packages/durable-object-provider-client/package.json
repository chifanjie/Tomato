{
  "name": "@understand-code/durable-object-provider-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "understand-code-provider-strong-object-gateway": "dist/provider-production-strong-object-gateway-cli.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm --filter @understand-code/durable-object-provider-runtime --fail-if-no-match build && pnpm run build && vitest run"
  },
  "dependencies": {
    "@understand-code/durable-object-provider-contracts": "workspace:*",
    "@understand-code/durable-object-provider-runtime": "workspace:*",
    "@understand-code/native-kernel-bridge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
