    {
      "caseId": "unknown-reason",
      "expectedFailure": {
        "keyword": "enum",
        "instancePath": "/details/reason"
      },
      "value": {
        "schemaVersion": 1,
        "code": "provider_unavailable",
        "details": {
          "reason": "network_error"
        }
      }
    },
    {
