    "build": "tsc && node scripts/build-browser-zod.mjs",
    "generate:schemas": "pnpm run build && node scripts/generate-json-schemas.mjs",
    "generate:bootstrap-trust-invalid": "pnpm run build && node scripts/generate-bootstrap-trust-invalid.mjs",
    "generate:provider-root-history": "pnpm run build && node scripts/generate-provider-registry-root-history.mjs",
    "generate:provider-registry-manifest-history": "pnpm run build && node scripts/generate-provider-registry-manifest-history.mjs",
    "generate:provider-registry-manifest-invalid": "pnpm run build && node scripts/generate-provider-registry-manifest-invalid.mjs",
    "generate:provider-real-fs-source": "pnpm run build && node scripts/generate-provider-real-filesystem-source.mjs",
    "generate:provider-real-fs-conformance-result": "pnpm run build && node scripts/generate-provider-real-filesystem-conformance-result.mjs",
    "generate:provider-runtime-attestation-point": "pnpm run build && node scripts/generate-provider-runtime-attestation-point.mjs",
    "generate:provider-feasibility-evidence-point": "pnpm run build && node scripts/generate-provider-feasibility-evidence-point.mjs",
    "generate:provider-feasibility-support-catalog-point": "pnpm run build && node scripts/generate-provider-feasibility-support-catalog-point.mjs",
    "generate:provider-registry-evidence-binding-point": "pnpm run build && node scripts/generate-provider-registry-evidence-binding-point.mjs",
    "generate:provider-registry-evidence-binding-topology-proof": "pnpm run build && node scripts/generate-provider-registry-evidence-binding-topology-proof.mjs",
    "generate:provider-target-discovery-point": "pnpm run build && node scripts/generate-provider-target-discovery-point.mjs",
    "generate:provider-release-target-universe-point": "pnpm run build && node scripts/generate-provider-release-target-universe-point.mjs",
    "generate:provider-distribution-history-current-candidate-point": "pnpm run build && node scripts/generate-provider-distribution-history-current-candidate-point.mjs",
    "prepack": "npm run build && npm run verify:all",
    "test:distribution": "node scripts/test-distribution.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify:golden": "node scripts/verify-golden.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:bootstrap-trust": "node scripts/verify-bootstrap-trust.mjs",
    "verify:bootstrap-trust-invalid": "node scripts/generate-bootstrap-trust-invalid.mjs --check && node scripts/verify-bootstrap-trust-invalid.mjs",
    "verify:provider-root-history": "node scripts/generate-provider-registry-root-history.mjs --check && node scripts/verify-provider-registry-root-history.mjs",
    "verify:provider-registry-manifest-history": "node scripts/generate-provider-registry-manifest-history.mjs --check && node scripts/verify-provider-registry-manifest-history.mjs",
    "verify:provider-registry-manifest-invalid": "node scripts/generate-provider-registry-manifest-invalid.mjs --check && node scripts/verify-provider-registry-manifest-invalid.mjs",
    "verify:provider-real-fs-source": "node scripts/generate-provider-real-filesystem-source.mjs --check && node scripts/verify-provider-real-filesystem-source.mjs",
    "verify:provider-real-fs-conformance-result": "node scripts/generate-provider-real-filesystem-conformance-result.mjs --check && node scripts/verify-provider-real-filesystem-conformance-result.mjs",
    "verify:provider-runtime-attestation-point": "node scripts/generate-provider-runtime-attestation-point.mjs --check && node scripts/verify-provider-runtime-attestation-point.mjs",
    "verify:provider-feasibility-evidence-point": "node scripts/generate-provider-feasibility-evidence-point.mjs --check && node scripts/verify-provider-feasibility-evidence-point.mjs",
    "verify:provider-feasibility-support-catalog-point": "node scripts/generate-provider-feasibility-support-catalog-point.mjs --check",
    "verify:provider-registry-evidence-binding-point": "node scripts/generate-provider-registry-evidence-binding-point.mjs --check && node scripts/verify-provider-registry-evidence-binding-point-evidence-adapter.mjs && node --max-old-space-size=768 --max-semi-space-size=16 scripts/verify-provider-registry-evidence-binding-point-registry-adapter.mjs && node --max-old-space-size=768 --max-semi-space-size=16 scripts/generate-provider-registry-evidence-binding-topology-proof.mjs --check",
    "test:provider-registry-evidence-binding-point-replay": "vitest run --maxWorkers=4 test/provider-registry-evidence-binding-point-fixtures-replay-lane-0.test.ts test/provider-registry-evidence-binding-point-fixtures-replay-lane-1.test.ts test/provider-registry-evidence-binding-point-fixtures-replay-lane-2.test.ts test/provider-registry-evidence-binding-point-fixtures-replay-lane-3.test.ts",
    "verify:provider-target-discovery-point": "node scripts/generate-provider-target-discovery-point.mjs --check && node scripts/verify-provider-target-discovery-point.mjs",
    "verify:provider-release-target-universe-point": "node scripts/generate-provider-release-target-universe-point.mjs --check && node scripts/verify-provider-release-target-universe-point.mjs",
    "verify:provider-distribution-history-current-candidate-point": "node scripts/generate-provider-distribution-history-current-candidate-point.mjs --check",
    "verify:schemas": "node scripts/generate-json-schemas.mjs --check",
    "verify:strict-ed25519": "node scripts/verify-strict-ed25519.mjs",
    "verify:all": "npm run verify:schemas && npm run verify:fixtures && npm run verify:strict-ed25519 && npm run verify:golden && npm run verify:bootstrap-trust-invalid && npm run verify:bootstrap-trust && npm run verify:provider-root-history && npm run verify:provider-registry-manifest-history && npm run verify:provider-registry-manifest-invalid && npm run verify:provider-real-fs-source && npm run verify:provider-target-discovery-point && npm run verify:provider-release-target-universe-point && npm run verify:provider-real-fs-conformance-result && npm run verify:provider-runtime-attestation-point && npm run verify:provider-feasibility-evidence-point && npm run verify:provider-registry-evidence-binding-point && npm run verify:provider-feasibility-support-catalog-point && npm run verify:provider-distribution-history-current-candidate-point",
    "test": "pnpm run build && pnpm run typecheck && vitest run --maxWorkers=1 && pnpm run test:distribution"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.7.0",
    "vite": "6.4.1",
    "vitest": "^3.1.0"
  }
}
