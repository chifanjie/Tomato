{
  "name": "@understand-code/durable-object-provider-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "provider",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jcs": {
      "types": "./dist/jcs.d.ts",
      "import": "./dist/jcs.js",
      "default": "./dist/jcs.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    },
    "./golden-vectors": {
      "types": "./dist/golden-vectors.d.ts",
      "import": "./dist/golden-vectors.js",
      "default": "./dist/golden-vectors.js"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.ts",
      "import": "./dist/json-schema.js",
      "default": "./dist/json-schema.js"
    },
    "./provider-error": {
      "types": "./dist/provider-error.d.ts",
      "import": "./dist/provider-error.js",
      "default": "./dist/provider-error.js"
    },
    "./provider-registry": {
      "types": "./dist/provider-registry.d.ts",
      "import": "./dist/provider-registry.js",
      "default": "./dist/provider-registry.js"
    },
    "./provider-real-filesystem-source": {
      "types": "./dist/provider-real-filesystem-source.d.ts",
      "import": "./dist/provider-real-filesystem-source.js",
      "default": "./dist/provider-real-filesystem-source.js"
    },
    "./public-key-digest": {
      "types": "./dist/public-key-digest.d.ts",
      "import": "./dist/public-key-digest.js",
      "default": "./dist/public-key-digest.js"
    },
    "./strict-ed25519": {
      "types": "./dist/strict-ed25519.d.ts",
      "import": "./dist/strict-ed25519.js",
      "default": "./dist/strict-ed25519.js"
    },
    "./strict-ed25519-conformance": {
      "types": "./dist/strict-ed25519-conformance.d.ts",
      "import": "./dist/strict-ed25519-conformance.js",
      "default": "./dist/strict-ed25519-conformance.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./provider/*": "./provider/*"
  },
  "scripts": {
    "build": "tsc",
    "generate:schemas": "pnpm run build && node scripts/generate-json-schemas.mjs",
    "generate:bootstrap-trust-invalid": "pnpm run build && node scripts/generate-bootstrap-trust-invalid.mjs",
    "generate:provider-root-history": "pnpm run build && node scripts/generate-provider-registry-root-history.mjs",
    "generate:provider-registry-manifest-history": "pnpm run build && node scripts/generate-provider-registry-manifest-history.mjs",
    "generate:provider-registry-manifest-invalid": "pnpm run build && node scripts/generate-provider-registry-manifest-invalid.mjs",
    "generate:provider-real-fs-source": "pnpm run build && node scripts/generate-provider-real-filesystem-source.mjs",
    "prepack": "npm run build && npm run verify:schemas && npm run verify:fixtures && npm run verify:strict-ed25519 && npm run verify:golden && npm run verify:bootstrap-trust-invalid && npm run verify:bootstrap-trust && npm run verify:provider-root-history && npm run verify:provider-registry-manifest-history && npm run verify:provider-registry-manifest-invalid && npm run verify:provider-real-fs-source",
    "test:distribution": "node scripts/test-distribution.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify:golden": "node scripts/verify-golden.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:bootstrap-trust": "node scripts/verify-bootstrap-trust.mjs",
    "verify:bootstrap-trust-invalid": "node scripts/generate-bootstrap-trust-invalid.mjs --check && node scripts/verify-bootstrap-trust-invalid.mjs",
    "verify:provider-root-history": "node scripts/generate-provider-registry-root-history.mjs --check && node scripts/verify-provider-registry-root-history.mjs",
    "verify:provider-registry-manifest-history": "node scripts/generate-provider-registry-manifest-history.mjs --check && node scripts/verify-provider-registry-manifest-history.mjs",
    "verify:provider-registry-manifest-invalid": "node scripts/generate-provider-registry-manifest-invalid.mjs --check && node scripts/verify-provider-registry-manifest-invalid.mjs",
    "verify:provider-real-fs-source": "node scripts/generate-provider-real-filesystem-source.mjs --check && node scripts/verify-provider-real-filesystem-source.mjs",
    "verify:schemas": "node scripts/generate-json-schemas.mjs --check",
    "verify:strict-ed25519": "node scripts/verify-strict-ed25519.mjs",
    "test": "pnpm run build && pnpm run typecheck && pnpm run verify:schemas && pnpm run verify:fixtures && pnpm run verify:strict-ed25519 && pnpm run verify:golden && pnpm run verify:bootstrap-trust-invalid && pnpm run verify:bootstrap-trust && pnpm run verify:provider-root-history && pnpm run verify:provider-registry-manifest-history && pnpm run verify:provider-registry-manifest-invalid && pnpm run verify:provider-real-fs-source && vitest run --maxWorkers=1 && pnpm run test:distribution"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.7.0",
    "vite": "6.4.1",
    "vitest": "^3.1.0"
  }
}
