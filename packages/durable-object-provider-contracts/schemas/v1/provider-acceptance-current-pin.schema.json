{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-acceptance-current-pin",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "highWaterLocatorProfile": {
      "type": "string",
      "const": "installation_provider_acceptance_high_water_v1"
    },
    "installationIdentityGenerationId": {
      "type": "string",
      "pattern": "^installation-identity-generation:[0-9a-f]{22}$"
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "locatorProfile": {
          "type": "string",
          "const": "installation_provider_acceptance_state_v1"
        },
        "acceptanceOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "generationId": {
          "type": "string",
          "pattern": "^provider-acceptance-state:[0-9a-f]{22}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "locatorProfile",
        "acceptanceOrdinal",
        "generationId",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "highWaterRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "highWaterContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "currentVersionToken": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "generationCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "generationSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acceptedGenerationFloors": {
      "type": "object",
      "properties": {
        "rootMetadataGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "registryManifestGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "supportCatalogGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "rootMetadataGeneration",
        "registryManifestGeneration",
        "supportCatalogGeneration"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "highWaterLocatorProfile",
    "installationIdentityGenerationId",
    "acceptance",
    "highWaterRevision",
    "highWaterContentDigest",
    "currentVersionToken",
    "generationCount",
    "generationSetDigest",
    "acceptedGenerationFloors"
  ],
  "additionalProperties": false
}
