{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-feasibility-approval-keys",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "provider_feasibility_approval_keys_v1"
    },
    "activeKeyIds": {
      "type": "object",
      "properties": {
        "qa": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        },
        "release": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        }
      },
      "required": [
        "qa",
        "release"
      ],
      "additionalProperties": false
    },
    "publicKeyRecords": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "const": "provider_feasibility_approver_public_key_v1"
          },
          "distributionRegistryGenerationIntroduced": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "role": {
            "type": "string",
            "enum": [
              "qa",
              "release"
            ]
          },
          "keyId": {
            "type": "string",
            "pattern": "^[0-9a-f]{22}$"
          },
          "algorithm": {
            "type": "string",
            "const": "ed25519"
          },
          "publicKeyBytes": {
            "type": "string",
            "pattern": "^base64url:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          },
          "publicKeyDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "registrySignature": {
            "type": "string",
            "pattern": "^provider-registry-ed25519:[0-9a-f]{22}:[0-9a-f]{128}$"
          }
        },
        "required": [
          "profile",
          "distributionRegistryGenerationIntroduced",
          "role",
          "keyId",
          "algorithm",
          "publicKeyBytes",
          "publicKeyDigest",
          "registrySignature"
        ],
        "additionalProperties": false
      }
    },
    "compromisedRevokedKeyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{22}$"
      }
    }
  },
  "required": [
    "profile",
    "activeKeyIds",
    "publicKeyRecords",
    "compromisedRevokedKeyIds"
  ],
  "additionalProperties": false
}
