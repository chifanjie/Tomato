{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-feasibility-evidence-pin",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locatorProfile": {
      "type": "string",
      "const": "installation_provider_feasibility_evidence_v1"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^provider-feasibility-evidence:[0-9a-f]{22}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "locatorProfile",
    "evidenceId",
    "contentDigest"
  ],
  "additionalProperties": false
}
