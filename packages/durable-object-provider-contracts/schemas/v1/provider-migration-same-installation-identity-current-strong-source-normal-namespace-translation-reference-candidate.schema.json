          "type": "string",
          "pattern": "^installation-identity-generation:[0-9a-f]{22}$"
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^provider-migration-same-installation-identity-current-strong-source-normal-repository-reference-candidate:[0-9a-f]{64}$"
