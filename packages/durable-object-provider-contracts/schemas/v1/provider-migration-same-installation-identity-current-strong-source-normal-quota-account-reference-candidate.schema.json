{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-migration-same-installation-identity-current-strong-source-normal-quota-account-reference-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accountOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reservationOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdByOperationNonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "accountReferenceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "reserved",
        "retained"
      ]
    },
    "migrationSlotCount": {
      "type": "number",
      "const": 1
    },
    "contribution": {
      "type": "object",
      "properties": {
        "historyLogicalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "historyProviderAllocatedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objectReceiptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objectReceiptLogicalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "semanticRootZeroProofCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "semanticRootZeroProofLogicalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "progressRecordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "progressRecordLogicalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "progressOperationReceiptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "progressOperationReceiptLogicalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "historyLogicalBytes",
        "historyProviderAllocatedBytes",
        "objectReceiptCount",
        "objectReceiptLogicalBytes",
        "semanticRootZeroProofCount",
        "semanticRootZeroProofLogicalBytes",
        "progressRecordCount",
        "progressRecordLogicalBytes",
        "progressOperationReceiptCount",
        "progressOperationReceiptLogicalBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "accountOrdinal",
    "reservationOrdinal",
    "createdByOperationNonce",
    "accountReferenceDigest",
    "state",
    "migrationSlotCount",
    "contribution"
  ],
  "additionalProperties": false
}
