{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-case-id-fields",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "fixtureRecordCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fixtureRecordSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "caseKey",
    "fixtureRecordCount",
    "fixtureRecordSetDigest"
  ],
  "additionalProperties": false
}
