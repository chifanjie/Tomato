{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-crash-cut-id-fields",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^provider-real-fs-case:[0-9a-f]{22}$"
    },
    "crashCutOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "injection": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "after_fixture_operation"
        },
        "afterFixtureOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "afterFixtureOrdinal"
      ],
      "additionalProperties": false
    },
    "recoveryAssertionContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "caseId",
    "crashCutOrdinal",
    "injection",
    "recoveryAssertionContentDigest"
  ],
  "additionalProperties": false
}
