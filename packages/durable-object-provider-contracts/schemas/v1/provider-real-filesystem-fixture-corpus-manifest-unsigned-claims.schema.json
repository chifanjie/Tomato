{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-fixture-corpus-manifest-unsigned-claims",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "provider_real_fs_fixture_corpus_manifest_v1"
    },
    "distributionRootBinding": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "const": "provider_signed_distribution_root_binding_v1"
        },
        "resolverProfile": {
          "type": "string",
          "const": "verified_signed_package_distribution_root_v1"
        },
        "signedPackageIdentityDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "releaseRevisionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bootstrapTrustBundle": {
          "type": "object",
          "properties": {
            "locatorProfile": {
              "type": "string",
              "const": "distribution_provider_bootstrap_trust_bundle_v1"
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "locatorProfile",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        "historyPolicy": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "provider_distribution_history_policy_v1"
            },
            "maxSupportCatalogGenerationCount": {
              "type": "number",
              "const": 4096
            },
            "maxPublicTaxonomyGenerationCount": {
              "type": "number",
              "const": 4096
            },
            "maxReleaseMatrixGenerationCount": {
              "type": "number",
              "const": 4096
            },
            "maxTargetDiscoveryResultGenerationCount": {
              "type": "number",
              "const": 4096
            },
            "maxReleaseTargetUniverseGenerationCount": {
              "type": "number",
              "const": 4096
            },
            "maxSingleDistributionObjectCanonicalBytes": {
              "type": "number",
              "const": 16777216
            },
            "maxTotalRetainedDistributionObjectCount": {
              "type": "number",
              "const": 65536
            },
            "maxTotalRetainedDistributionHistoryLogicalBytes": {
              "type": "number",
              "const": 536870912
            },
            "normalUpdateEmergencyGenerationReservePerChain": {
              "type": "number",
              "const": 8
            },
            "normalUpdateEmergencyLogicalBytesReserve": {
              "type": "number",
              "const": 16777216
            },
            "admission": {
              "type": "string",
              "const": "stream_verify_five_chains_embedded_bundles_and_transitive_source_envelopes_before_accepting_distribution"
            },
            "exhaustion": {
              "type": "string",
              "const": "reject_candidate_distribution_and_preserve_last_verified_distribution"
            }
          },
          "required": [
            "profile",
            "maxSupportCatalogGenerationCount",
            "maxPublicTaxonomyGenerationCount",
            "maxReleaseMatrixGenerationCount",
            "maxTargetDiscoveryResultGenerationCount",
            "maxReleaseTargetUniverseGenerationCount",
            "maxSingleDistributionObjectCanonicalBytes",
            "maxTotalRetainedDistributionObjectCount",
            "maxTotalRetainedDistributionHistoryLogicalBytes",
            "normalUpdateEmergencyGenerationReservePerChain",
            "normalUpdateEmergencyLogicalBytesReserve",
            "admission",
            "exhaustion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profile",
        "resolverProfile",
        "signedPackageIdentityDigest",
        "releaseRevisionDigest",
        "bootstrapTrustBundle",
        "historyPolicy"
      ],
      "additionalProperties": false
    },
    "activeRootMetadata": {
      "type": "object",
      "properties": {
        "locatorProfile": {
          "type": "string",
          "const": "installation_provider_registry_root_metadata_v1"
        },
        "rootGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rootKeyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "locatorProfile",
        "rootGeneration",
        "rootKeyId",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "registryRootKeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{22}$"
    },
    "releaseRevisionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "corpusVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "recordSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "records": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "fixtureOrdinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fixtureRole": {
            "type": "string",
            "enum": [
              "setup",
              "operation",
              "assertion"
            ]
          },
          "fixtureProgramProfile": {
            "type": "string",
            "const": "provider_real_fs_fixture_program_v1"
          },
          "fixtureProgramBytes": {
            "type": "string",
            "pattern": "^base64url:(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
          },
          "fixtureProgramContentDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "fixtureProgramLogicalBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "caseKey",
          "fixtureOrdinal",
          "fixtureRole",
          "fixtureProgramProfile",
          "fixtureProgramBytes",
          "fixtureProgramContentDigest",
          "fixtureProgramLogicalBytes"
        ],
        "additionalProperties": false
      }
    },
    "fixtureManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "profile",
    "distributionRootBinding",
    "activeRootMetadata",
    "registryRootKeyId",
    "releaseRevisionDigest",
    "corpusVersion",
    "recordCount",
    "recordSetDigest",
    "records",
    "fixtureManifestDigest"
  ],
  "additionalProperties": false
}
