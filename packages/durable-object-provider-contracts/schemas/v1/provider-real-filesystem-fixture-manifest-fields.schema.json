{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-fixture-manifest-fields",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "corpusVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "recordSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "records": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "fixtureOrdinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fixtureRole": {
            "type": "string",
            "enum": [
              "setup",
              "operation",
              "assertion"
            ]
          },
          "fixtureProgramProfile": {
            "type": "string",
            "const": "provider_real_fs_fixture_program_v1"
          },
          "fixtureProgramBytes": {
            "type": "string",
            "pattern": "^base64url:(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
          },
          "fixtureProgramContentDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "fixtureProgramLogicalBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "caseKey",
          "fixtureOrdinal",
          "fixtureRole",
          "fixtureProgramProfile",
          "fixtureProgramBytes",
          "fixtureProgramContentDigest",
          "fixtureProgramLogicalBytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "corpusVersion",
    "recordCount",
    "recordSetDigest",
    "records"
  ],
  "additionalProperties": false
}
