{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-recovery-assertion-fields",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recoveryAssertionProfile": {
      "type": "string",
      "const": "provider_real_fs_recovery_assertion_v1"
    },
    "recoveryAssertionBytes": {
      "type": "string",
      "pattern": "^base64url:(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    }
  },
  "required": [
    "recoveryAssertionProfile",
    "recoveryAssertionBytes"
  ],
  "additionalProperties": false
}
