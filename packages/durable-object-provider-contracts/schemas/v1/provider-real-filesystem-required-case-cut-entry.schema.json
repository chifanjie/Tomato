{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-required-case-cut-entry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^provider-real-fs-case:[0-9a-f]{22}$"
    },
    "crashCutId": {
      "type": "string",
      "pattern": "^(?:no-crash|provider-crash-cut:[0-9a-f]{22})$"
    }
  },
  "required": [
    "caseId",
    "crashCutId"
  ],
  "additionalProperties": false
}
