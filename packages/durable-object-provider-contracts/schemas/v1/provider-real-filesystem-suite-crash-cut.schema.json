{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-suite-crash-cut",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "crashCutId": {
          "type": "string",
          "pattern": "^(?:no-crash|provider-crash-cut:[0-9a-f]{22})$"
        },
        "crashCutOrdinal": {
          "type": "number",
          "const": 0
        },
        "injection": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "crashCutId",
        "crashCutOrdinal",
        "injection"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "crashCutId": {
          "type": "string",
          "pattern": "^(?:no-crash|provider-crash-cut:[0-9a-f]{22})$"
        },
        "crashCutOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "injection": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "after_fixture_operation"
            },
            "afterFixtureOrdinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "state",
            "afterFixtureOrdinal"
          ],
          "additionalProperties": false
        },
        "recoveryAssertionProfile": {
          "type": "string",
          "const": "provider_real_fs_recovery_assertion_v1"
        },
        "recoveryAssertionBytes": {
          "type": "string",
          "pattern": "^base64url:(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
        },
        "recoveryAssertionContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "crashCutId",
        "crashCutOrdinal",
        "injection",
        "recoveryAssertionProfile",
        "recoveryAssertionBytes",
        "recoveryAssertionContentDigest"
      ],
      "additionalProperties": false
    }
  ]
}
