{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-real-filesystem-suite-manifest-signature-wrapper",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rootKeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{22}$"
    },
    "domain": {
      "type": "string",
      "const": "provider-real-fs-suite-manifest-signature-v1"
    },
    "claims": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "const": "provider_real_fs_suite_manifest_v1"
        },
        "distributionRootBinding": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "provider_signed_distribution_root_binding_v1"
            },
            "resolverProfile": {
              "type": "string",
              "const": "verified_signed_package_distribution_root_v1"
            },
            "signedPackageIdentityDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "releaseRevisionDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bootstrapTrustBundle": {
              "type": "object",
              "properties": {
                "locatorProfile": {
                  "type": "string",
                  "const": "distribution_provider_bootstrap_trust_bundle_v1"
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "locatorProfile",
                "contentDigest"
              ],
              "additionalProperties": false
            },
            "historyPolicy": {
              "type": "object",
              "properties": {
                "profile": {
                  "type": "string",
                  "const": "provider_distribution_history_policy_v1"
                },
                "maxSupportCatalogGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxPublicTaxonomyGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxReleaseMatrixGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxTargetDiscoveryResultGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxReleaseTargetUniverseGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxSingleDistributionObjectCanonicalBytes": {
                  "type": "number",
                  "const": 16777216
                },
                "maxTotalRetainedDistributionObjectCount": {
                  "type": "number",
                  "const": 65536
                },
                "maxTotalRetainedDistributionHistoryLogicalBytes": {
                  "type": "number",
                  "const": 536870912
                },
                "normalUpdateEmergencyGenerationReservePerChain": {
                  "type": "number",
                  "const": 8
                },
                "normalUpdateEmergencyLogicalBytesReserve": {
                  "type": "number",
                  "const": 16777216
                },
                "admission": {
                  "type": "string",
                  "const": "stream_verify_five_chains_embedded_bundles_and_transitive_source_envelopes_before_accepting_distribution"
                },
                "exhaustion": {
                  "type": "string",
                  "const": "reject_candidate_distribution_and_preserve_last_verified_distribution"
                }
              },
              "required": [
                "profile",
                "maxSupportCatalogGenerationCount",
                "maxPublicTaxonomyGenerationCount",
                "maxReleaseMatrixGenerationCount",
                "maxTargetDiscoveryResultGenerationCount",
                "maxReleaseTargetUniverseGenerationCount",
                "maxSingleDistributionObjectCanonicalBytes",
                "maxTotalRetainedDistributionObjectCount",
                "maxTotalRetainedDistributionHistoryLogicalBytes",
                "normalUpdateEmergencyGenerationReservePerChain",
                "normalUpdateEmergencyLogicalBytesReserve",
                "admission",
                "exhaustion"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "profile",
            "resolverProfile",
            "signedPackageIdentityDigest",
            "releaseRevisionDigest",
            "bootstrapTrustBundle",
            "historyPolicy"
          ],
          "additionalProperties": false
        },
        "activeRootMetadata": {
          "type": "object",
          "properties": {
            "locatorProfile": {
              "type": "string",
              "const": "installation_provider_registry_root_metadata_v1"
            },
            "rootGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "rootKeyId": {
              "type": "string",
              "pattern": "^[0-9a-f]{22}$"
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "locatorProfile",
            "rootGeneration",
            "rootKeyId",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        "registryRootKeyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        },
        "releaseRevisionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "suiteVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "fixtureCorpusManifest": {
          "type": "object",
          "properties": {
            "locatorProfile": {
              "type": "string",
              "const": "distribution_provider_real_fs_fixture_corpus_manifest_v1"
            },
            "distributionRootBinding": {
              "type": "object",
              "properties": {
                "profile": {
                  "type": "string",
                  "const": "provider_signed_distribution_root_binding_v1"
                },
                "resolverProfile": {
                  "type": "string",
                  "const": "verified_signed_package_distribution_root_v1"
                },
                "signedPackageIdentityDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "releaseRevisionDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "bootstrapTrustBundle": {
                  "type": "object",
                  "properties": {
                    "locatorProfile": {
                      "type": "string",
                      "const": "distribution_provider_bootstrap_trust_bundle_v1"
                    },
                    "contentDigest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "locatorProfile",
                    "contentDigest"
                  ],
                  "additionalProperties": false
                },
                "historyPolicy": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "string",
                      "const": "provider_distribution_history_policy_v1"
                    },
                    "maxSupportCatalogGenerationCount": {
                      "type": "number",
                      "const": 4096
                    },
                    "maxPublicTaxonomyGenerationCount": {
                      "type": "number",
                      "const": 4096
                    },
                    "maxReleaseMatrixGenerationCount": {
                      "type": "number",
                      "const": 4096
                    },
                    "maxTargetDiscoveryResultGenerationCount": {
                      "type": "number",
                      "const": 4096
                    },
                    "maxReleaseTargetUniverseGenerationCount": {
                      "type": "number",
                      "const": 4096
                    },
                    "maxSingleDistributionObjectCanonicalBytes": {
                      "type": "number",
                      "const": 16777216
                    },
                    "maxTotalRetainedDistributionObjectCount": {
                      "type": "number",
                      "const": 65536
                    },
                    "maxTotalRetainedDistributionHistoryLogicalBytes": {
                      "type": "number",
                      "const": 536870912
                    },
                    "normalUpdateEmergencyGenerationReservePerChain": {
                      "type": "number",
                      "const": 8
                    },
                    "normalUpdateEmergencyLogicalBytesReserve": {
                      "type": "number",
                      "const": 16777216
                    },
                    "admission": {
                      "type": "string",
                      "const": "stream_verify_five_chains_embedded_bundles_and_transitive_source_envelopes_before_accepting_distribution"
                    },
                    "exhaustion": {
                      "type": "string",
                      "const": "reject_candidate_distribution_and_preserve_last_verified_distribution"
                    }
                  },
                  "required": [
                    "profile",
                    "maxSupportCatalogGenerationCount",
                    "maxPublicTaxonomyGenerationCount",
                    "maxReleaseMatrixGenerationCount",
                    "maxTargetDiscoveryResultGenerationCount",
                    "maxReleaseTargetUniverseGenerationCount",
                    "maxSingleDistributionObjectCanonicalBytes",
                    "maxTotalRetainedDistributionObjectCount",
                    "maxTotalRetainedDistributionHistoryLogicalBytes",
                    "normalUpdateEmergencyGenerationReservePerChain",
                    "normalUpdateEmergencyLogicalBytesReserve",
                    "admission",
                    "exhaustion"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "profile",
                "resolverProfile",
                "signedPackageIdentityDigest",
                "releaseRevisionDigest",
                "bootstrapTrustBundle",
                "historyPolicy"
              ],
              "additionalProperties": false
            },
            "fixtureManifestDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "locatorProfile",
            "distributionRootBinding",
            "fixtureManifestDigest",
            "contentDigest"
          ],
          "additionalProperties": false
        },
        "runnerProfile": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "provider_real_fs_runner_profile_v1"
            },
            "protocolVersion": {
              "type": "string",
              "const": "provider-real-fs-runner-v1"
            },
            "canonicalProfileBytes": {
              "type": "string",
              "pattern": "^base64url:(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
            }
          },
          "required": [
            "profile",
            "protocolVersion",
            "canonicalProfileBytes"
          ],
          "additionalProperties": false
        },
        "runnerProfileDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "caseCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "caseSetDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "requiredCaseCutCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requiredCaseCutSetDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "caseId": {
                "type": "string",
                "pattern": "^provider-real-fs-case:[0-9a-f]{22}$"
              },
              "caseKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "fixtureRecordCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "fixtureRecordSetDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "requiredCrashCuts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "crashCutId": {
                          "type": "string",
                          "pattern": "^(?:no-crash|provider-crash-cut:[0-9a-f]{22})$"
                        },
                        "crashCutOrdinal": {
                          "type": "number",
                          "const": 0
                        },
                        "injection": {
                          "type": "object",
                          "properties": {
                            "state": {
                              "type": "string",
                              "const": "none"
                            }
                          },
                          "required": [
                            "state"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "crashCutId",
                        "crashCutOrdinal",
                        "injection"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "crashCutId": {
                          "type": "string",
                          "pattern": "^(?:no-crash|provider-crash-cut:[0-9a-f]{22})$"
                        },
                        "crashCutOrdinal": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "injection": {
                          "type": "object",
                          "properties": {
                            "state": {
                              "type": "string",
                              "const": "after_fixture_operation"
                            },
                            "afterFixtureOrdinal": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "state",
                            "afterFixtureOrdinal"
                          ],
                          "additionalProperties": false
                        },
                        "recoveryAssertionProfile": {
                          "type": "string",
                          "const": "provider_real_fs_recovery_assertion_v1"
                        },
                        "recoveryAssertionBytes": {
                          "type": "string",
                          "pattern": "^base64url:(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
                        },
                        "recoveryAssertionContentDigest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "crashCutId",
                        "crashCutOrdinal",
                        "injection",
                        "recoveryAssertionProfile",
                        "recoveryAssertionBytes",
                        "recoveryAssertionContentDigest"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "caseId",
              "caseKey",
              "fixtureRecordCount",
              "fixtureRecordSetDigest",
              "requiredCrashCuts"
            ],
            "additionalProperties": false
          }
        },
        "suiteDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "profile",
        "distributionRootBinding",
        "activeRootMetadata",
        "registryRootKeyId",
        "releaseRevisionDigest",
        "suiteVersion",
        "fixtureCorpusManifest",
        "runnerProfile",
        "runnerProfileDigest",
        "caseCount",
        "caseSetDigest",
        "requiredCaseCutCount",
        "requiredCaseCutSetDigest",
        "cases",
        "suiteDigest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "rootKeyId",
    "domain",
    "claims"
  ],
  "additionalProperties": false
}
