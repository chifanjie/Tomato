{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-registry-manifest-locator",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locatorProfile": {
      "type": "string",
      "const": "installation_provider_registry_manifest_v1"
    },
    "generationId": {
      "type": "string",
      "pattern": "^provider-registry-manifest:[0-9a-f]{22}$"
    }
  },
  "required": [
    "locatorProfile",
    "generationId"
  ],
  "additionalProperties": false
}
