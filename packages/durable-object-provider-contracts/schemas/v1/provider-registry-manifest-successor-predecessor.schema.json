{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-registry-manifest-successor-predecessor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "const": "manifest"
    },
    "generationId": {
      "type": "string",
      "pattern": "^provider-registry-manifest:[0-9a-f]{22}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "state",
    "generationId",
    "contentDigest"
  ],
  "additionalProperties": false
}
