{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-registry-recovery-public-key",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "provider_registry_recovery_public_key_v1"
    },
    "recoveryKeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{22}$"
    },
    "algorithm": {
      "type": "string",
      "const": "ed25519"
    },
    "publicKeyBytes": {
      "type": "string",
      "pattern": "^base64url:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "publicKeyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "profile",
    "recoveryKeyId",
    "algorithm",
    "publicKeyBytes",
    "publicKeyDigest"
  ],
  "additionalProperties": false
}
