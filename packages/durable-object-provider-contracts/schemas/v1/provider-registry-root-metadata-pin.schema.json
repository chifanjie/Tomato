{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-registry-root-metadata-pin",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locatorProfile": {
      "type": "string",
      "const": "installation_provider_registry_root_metadata_v1"
    },
    "rootGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rootKeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{22}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "locatorProfile",
    "rootGeneration",
    "rootKeyId",
    "contentDigest"
  ],
  "additionalProperties": false
}
