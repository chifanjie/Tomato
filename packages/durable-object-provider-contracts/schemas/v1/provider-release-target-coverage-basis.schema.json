{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-release-target-coverage-basis",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "provider_release_target_coverage_basis_v1"
    },
    "releaseMatrix": {
      "type": "object",
      "properties": {
        "locatorProfile": {
          "type": "string",
          "const": "distribution_provider_release_matrix_v1"
        },
        "releaseMatrixGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "locatorProfile",
        "releaseMatrixGeneration",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "targetDiscoveryResult": {
      "type": "object",
      "properties": {
        "locatorProfile": {
          "type": "string",
          "const": "distribution_provider_target_discovery_result_v1"
        },
        "discoveryGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "locatorProfile",
        "discoveryGeneration",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "targetDiscoveryInputBundleContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observationCutDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observationSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "limits": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^provider_release_coverage_artifact_limits_v[1-9][0-9]*$"
        },
        "maxTargetEntriesPerArtifact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCanonicalUnionTargetEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxUnresolvedObservationsPerDiscoveryResult": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCanonicalEnvelopeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "profile",
        "maxTargetEntriesPerArtifact",
        "maxCanonicalUnionTargetEntries",
        "maxUnresolvedObservationsPerDiscoveryResult",
        "maxCanonicalEnvelopeBytes"
      ],
      "additionalProperties": false
    },
    "discoveryRulesetVersion": {
      "type": "string",
      "pattern": "^provider_release_target_discovery_v[1-9][0-9]*$"
    },
    "requiredDimensions": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "enum": [
            "osPlatform",
            "osReleaseFamilyCode",
            "osBuildDigest",
            "architecture",
            "filesystemProfileCode",
            "filesystemFeatureProfileDigest",
            "mountOptionProfileDigest"
          ]
        },
        {
          "type": "string",
          "enum": [
            "osPlatform",
            "osReleaseFamilyCode",
            "osBuildDigest",
            "architecture",
            "filesystemProfileCode",
            "filesystemFeatureProfileDigest",
            "mountOptionProfileDigest"
          ]
        },
        {
          "type": "string",
          "enum": [
            "osPlatform",
            "osReleaseFamilyCode",
            "osBuildDigest",
            "architecture",
            "filesystemProfileCode",
            "filesystemFeatureProfileDigest",
            "mountOptionProfileDigest"
          ]
        },
        {
          "type": "string",
          "enum": [
            "osPlatform",
            "osReleaseFamilyCode",
            "osBuildDigest",
            "architecture",
            "filesystemProfileCode",
            "filesystemFeatureProfileDigest",
            "mountOptionProfileDigest"
          ]
        },
        {
          "type": "string",
          "enum": [
            "osPlatform",
            "osReleaseFamilyCode",
            "osBuildDigest",
            "architecture",
            "filesystemProfileCode",
            "filesystemFeatureProfileDigest",
            "mountOptionProfileDigest"
          ]
        },
        {
          "type": "string",
          "enum": [
            "osPlatform",
            "osReleaseFamilyCode",
            "osBuildDigest",
            "architecture",
            "filesystemProfileCode",
            "filesystemFeatureProfileDigest",
            "mountOptionProfileDigest"
          ]
        },
        {
          "type": "string",
          "enum": [
            "osPlatform",
            "osReleaseFamilyCode",
            "osBuildDigest",
            "architecture",
            "filesystemProfileCode",
            "filesystemFeatureProfileDigest",
            "mountOptionProfileDigest"
          ]
        }
      ],
      "minItems": 7,
      "maxItems": 7,
      "items": false
    },
    "observationSources": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "enum": [
            "signed_release_matrix",
            "real_filesystem_fixture_manifest",
            "target_discovery_runner"
          ]
        },
        {
          "type": "string",
          "enum": [
            "signed_release_matrix",
            "real_filesystem_fixture_manifest",
            "target_discovery_runner"
          ]
        },
        {
          "type": "string",
          "enum": [
            "signed_release_matrix",
            "real_filesystem_fixture_manifest",
            "target_discovery_runner"
          ]
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "releaseMatrixTargetCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "releaseMatrixTargetSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "discoveredTargetCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "discoveredTargetSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "unresolvedObservationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "closed_world_complete"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "incomplete"
            },
            "reason": {
              "type": "string",
              "enum": [
                "release_matrix_incomplete",
                "target_discovery_unresolved",
                "taxonomy_mapping_unresolved"
              ]
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "profile",
    "releaseMatrix",
    "targetDiscoveryResult",
    "targetDiscoveryInputBundleContentDigest",
    "observationCutDigest",
    "observationSetDigest",
    "limits",
    "discoveryRulesetVersion",
    "requiredDimensions",
    "observationSources",
    "releaseMatrixTargetCount",
    "releaseMatrixTargetSetDigest",
    "discoveredTargetCount",
    "discoveredTargetSetDigest",
    "unresolvedObservationCount",
    "resolution"
  ],
  "additionalProperties": false
}
