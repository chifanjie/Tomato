{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-release-target-universe-bucket",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "publicProfileId": {
      "type": "string",
      "pattern": "^provider-public-support-profile:[0-9a-f]{64}$"
    },
    "osPlatform": {
      "type": "string",
      "enum": [
        "darwin",
        "linux"
      ]
    },
    "osReleaseFamilyCode": {
      "type": "string",
      "pattern": "^provider-os-family:[0-9a-f]{22}$"
    },
    "architecture": {
      "type": "string",
      "enum": [
        "arm64",
        "x86_64"
      ]
    },
    "filesystemProfileCode": {
      "type": "string",
      "pattern": "^provider-fs-profile:[0-9a-f]{22}$"
    },
    "coverage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "coverageState": {
              "type": "string",
              "const": "closed_world_complete"
            },
            "targetProfileIds": {
              "minItems": 1,
              "maxItems": 4096,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^provider-target-profile:[0-9a-f]{64}$"
              }
            }
          },
          "required": [
            "coverageState",
            "targetProfileIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "coverageState": {
              "type": "string",
              "const": "incomplete"
            },
            "reason": {
              "type": "string",
              "enum": [
                "release_matrix_incomplete",
                "target_discovery_unresolved",
                "taxonomy_mapping_unresolved"
              ]
            },
            "targetProfileIds": {
              "minItems": 1,
              "maxItems": 4096,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^provider-target-profile:[0-9a-f]{64}$"
              }
            }
          },
          "required": [
            "coverageState",
            "reason",
            "targetProfileIds"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "publicProfileId",
    "osPlatform",
    "osReleaseFamilyCode",
    "architecture",
    "filesystemProfileCode",
    "coverage"
  ],
  "additionalProperties": false
}
