{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-runtime-ipc-principal-challenge-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "understand_code_durable_provider_ipc_v1"
    },
    "kind": {
      "type": "string",
      "const": "principal_challenge"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptanceIdentityProofRequested": {
      "type": "boolean",
      "const": true
    },
    "sessionContinuationRequested": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "protocol",
    "kind",
    "challenge"
  ],
  "additionalProperties": false
}
