{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-strict-ed25519-crypto-capability",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "provider_strict_ed25519_crypto_capability_v1"
    },
    "verificationProfile": {
      "type": "string",
      "const": "ed25519-rfc8032-cofactorless-prime-subgroup-v1"
    },
    "adversarialManifest": {
      "type": "object",
      "properties": {
        "locatorProfile": {
          "type": "string",
          "const": "distribution_provider_strict_ed25519_adversarial_manifest_v1"
        },
        "manifestVersion": {
          "type": "number",
          "const": 1
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "locatorProfile",
        "manifestVersion",
        "contentDigest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "verificationProfile",
    "adversarialManifest"
  ],
  "additionalProperties": false
}
