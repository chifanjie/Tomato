{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-target-discovery-observation-key-fields",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observationSource": {
      "type": "string",
      "enum": [
        "signed_release_matrix",
        "real_filesystem_fixture_manifest",
        "target_discovery_runner"
      ]
    },
    "sourceArtifactContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRecordOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "privacySafeObservationClaimsDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "observationSource",
    "sourceArtifactContentDigest",
    "sourceRecordOrdinal",
    "privacySafeObservationClaimsDigest"
  ],
  "additionalProperties": false
}
