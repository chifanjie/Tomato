{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-target-discovery-runner-run-envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "recordType": {
      "type": "string",
      "const": "provider_target_discovery_runner_run"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "const": "provider_target_discovery_runner_run_manifest_v1"
        },
        "distributionRootBinding": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "provider_signed_distribution_root_binding_v1"
            },
            "resolverProfile": {
              "type": "string",
              "const": "verified_signed_package_distribution_root_v1"
            },
            "signedPackageIdentityDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "releaseRevisionDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bootstrapTrustBundle": {
              "type": "object",
              "properties": {
                "locatorProfile": {
                  "type": "string",
                  "const": "distribution_provider_bootstrap_trust_bundle_v1"
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "locatorProfile",
                "contentDigest"
              ],
              "additionalProperties": false
            },
            "historyPolicy": {
              "type": "object",
              "properties": {
                "profile": {
                  "type": "string",
                  "const": "provider_distribution_history_policy_v1"
                },
                "maxSupportCatalogGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxPublicTaxonomyGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxReleaseMatrixGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxTargetDiscoveryResultGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxReleaseTargetUniverseGenerationCount": {
                  "type": "number",
                  "const": 4096
                },
                "maxSingleDistributionObjectCanonicalBytes": {
                  "type": "number",
                  "const": 16777216
                },
                "maxTotalRetainedDistributionObjectCount": {
                  "type": "number",
                  "const": 65536
                },
                "maxTotalRetainedDistributionHistoryLogicalBytes": {
                  "type": "number",
                  "const": 536870912
                },
                "normalUpdateEmergencyGenerationReservePerChain": {
                  "type": "number",
                  "const": 8
                },
                "normalUpdateEmergencyLogicalBytesReserve": {
                  "type": "number",
                  "const": 16777216
                },
                "admission": {
                  "type": "string",
                  "const": "stream_verify_five_chains_embedded_bundles_and_transitive_source_envelopes_before_accepting_distribution"
                },
                "exhaustion": {
                  "type": "string",
                  "const": "reject_candidate_distribution_and_preserve_last_verified_distribution"
                }
              },
              "required": [
                "profile",
                "maxSupportCatalogGenerationCount",
                "maxPublicTaxonomyGenerationCount",
                "maxReleaseMatrixGenerationCount",
                "maxTargetDiscoveryResultGenerationCount",
                "maxReleaseTargetUniverseGenerationCount",
                "maxSingleDistributionObjectCanonicalBytes",
                "maxTotalRetainedDistributionObjectCount",
                "maxTotalRetainedDistributionHistoryLogicalBytes",
                "normalUpdateEmergencyGenerationReservePerChain",
                "normalUpdateEmergencyLogicalBytesReserve",
                "admission",
                "exhaustion"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "profile",
            "resolverProfile",
            "signedPackageIdentityDigest",
            "releaseRevisionDigest",
            "bootstrapTrustBundle",
            "historyPolicy"
          ],
          "additionalProperties": false
        },
        "releaseRevisionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "producerName": {
          "type": "string",
          "const": "understand-code"
        },
        "producerVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "implementationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binaryAttestationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runnerProfileDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "targetRecordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "targetRecordSetDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceRecordOrdinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outcome": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "resolved"
                      },
                      "target": {
                        "type": "object",
                        "properties": {
                          "target": {
                            "type": "object",
                            "properties": {
                              "targetProfileId": {
                                "type": "string",
                                "pattern": "^provider-target-profile:[0-9a-f]{64}$"
                              },
                              "osPlatform": {
                                "type": "string",
                                "enum": [
                                  "darwin",
                                  "linux"
                                ]
                              },
                              "osReleaseFamilyCode": {
                                "type": "string",
                                "pattern": "^provider-os-family:[0-9a-f]{22}$"
                              },
                              "osBuildDigest": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              "architecture": {
                                "type": "string",
                                "enum": [
                                  "arm64",
                                  "x86_64"
                                ]
                              },
                              "filesystemProfileCode": {
                                "type": "string",
                                "pattern": "^provider-fs-profile:[0-9a-f]{22}$"
                              },
                              "filesystemFeatureProfileDigest": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              "mountOptionProfileDigest": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              }
                            },
                            "required": [
                              "targetProfileId",
                              "osPlatform",
                              "osReleaseFamilyCode",
                              "osBuildDigest",
                              "architecture",
                              "filesystemProfileCode",
                              "filesystemFeatureProfileDigest",
                              "mountOptionProfileDigest"
                            ],
                            "additionalProperties": false
                          },
                          "publicProfileId": {
                            "type": "string",
                            "pattern": "^provider-public-support-profile:[0-9a-f]{64}$"
                          }
                        },
                        "required": [
                          "target",
                          "publicProfileId"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "state",
                      "target"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "unresolved"
                      },
                      "reason": {
                        "type": "string",
                        "enum": [
                          "target_dimensions_missing",
                          "taxonomy_mapping_unresolved",
                          "conflicting_target_claims",
                          "observation_source_unavailable"
                        ]
                      }
                    },
                    "required": [
                      "state",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "sourceRecordOrdinal",
              "outcome"
            ],
            "additionalProperties": false
          }
        },
        "executedAt": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
        }
      },
      "required": [
        "profile",
        "distributionRootBinding",
        "releaseRevisionDigest",
        "producerName",
        "producerVersion",
        "implementationDigest",
        "binaryAttestationDigest",
        "runnerProfileDigest",
        "targetRecordCount",
        "targetRecordSetDigest",
        "records",
        "executedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "contentDigest",
    "payload"
  ],
  "additionalProperties": false
}
