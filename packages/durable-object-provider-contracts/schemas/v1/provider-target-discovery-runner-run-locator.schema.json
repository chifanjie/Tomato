  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locatorProfile": {
      "type": "string",
      "const": "distribution_provider_target_discovery_runner_run_v1"
    },
    "runManifestContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
