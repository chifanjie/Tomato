{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-target-discovery-unresolved-observation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observationSource": {
      "type": "string",
      "enum": [
        "signed_release_matrix",
        "real_filesystem_fixture_manifest",
        "target_discovery_runner"
      ]
    },
    "sourceArtifactContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRecordOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "privacySafeObservationClaimsDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observationKeyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "target_dimensions_missing",
        "taxonomy_mapping_unresolved",
        "conflicting_target_claims",
        "observation_source_unavailable"
      ]
    }
  },
  "required": [
    "observationSource",
    "sourceArtifactContentDigest",
    "sourceRecordOrdinal",
    "privacySafeObservationClaimsDigest",
    "observationKeyDigest",
    "reason"
  ],
  "additionalProperties": false
}
