{
  "$id": "urn:understand-code:provider-contract:schema:v1:provider-unavailable-tool-error",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "code": {
      "type": "string",
      "const": "provider_unavailable"
    },
    "details": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "unavailable",
            "unsupported_filesystem_profile",
            "attestation_invalid",
            "revoked",
            "migration_required",
            "initialization_not_terminalized"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "code",
    "details"
  ],
  "additionalProperties": false
}
