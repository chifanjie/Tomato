{
  "$id": "urn:understand-code:provider-contract:schema:v1:store-durable-object-provider-verification-keys",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "store_durable_object_provider_verification_keys_v1"
    },
    "activeKeyIds": {
      "type": "object",
      "properties": {
        "operationReceipt": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        },
        "containmentProof": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        },
        "stateVersion": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        },
        "journalVersion": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        },
        "strongMutationAuthorityGrant": {
          "type": "string",
          "pattern": "^[0-9a-f]{22}$"
        }
      },
      "required": [
        "operationReceipt",
        "containmentProof",
        "stateVersion",
        "journalVersion"
      ],
      "additionalProperties": false
    },
    "activeBindingDerivationKeyGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "publicKeyRecords": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "const": "store_durable_object_provider_verification_public_key_v1"
          },
          "providerId": {
            "type": "string",
            "pattern": "^durable-object-provider:(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
          },
          "registryGenerationIntroduced": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "keyId": {
            "type": "string",
            "pattern": "^[0-9a-f]{22}$"
          },
          "usage": {
            "type": "string",
            "enum": [
              "operation_receipt",
              "containment_proof",
              "state_version",
              "journal_version",
              "migration_semantic_proof",
              "strong_mutation_authority_grant"
            ]
          },
          "algorithm": {
            "type": "string",
            "const": "ed25519"
          },
          "publicKeyBytes": {
            "type": "string",
            "pattern": "^base64url:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          },
          "publicKeyDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "registrySignature": {
            "type": "string",
            "pattern": "^provider-registry-ed25519:[0-9a-f]{22}:[0-9a-f]{128}$"
          }
        },
        "required": [
          "profile",
          "providerId",
          "registryGenerationIntroduced",
          "keyId",
          "usage",
          "algorithm",
          "publicKeyBytes",
          "publicKeyDigest",
          "registrySignature"
        ],
        "additionalProperties": false
      }
    },
    "bindingDerivationGenerationRecords": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "const": "store_durable_object_provider_binding_derivation_generation_v1"
          },
          "providerId": {
            "type": "string",
            "pattern": "^durable-object-provider:(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
          },
          "registryGenerationIntroduced": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "algorithm": {
            "type": "string",
            "const": "hmac_sha256_provider_private"
          },
          "keyCommitmentDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "registrySignature": {
            "type": "string",
            "pattern": "^provider-registry-ed25519:[0-9a-f]{22}:[0-9a-f]{128}$"
          }
        },
        "required": [
          "profile",
          "providerId",
          "registryGenerationIntroduced",
          "generation",
          "algorithm",
          "keyCommitmentDigest",
          "registrySignature"
        ],
        "additionalProperties": false
      }
    },
    "compromisedRevokedKeyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{22}$"
      }
    },
    "compromisedRevokedBindingDerivationGenerations": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "profile",
    "activeKeyIds",
    "activeBindingDerivationKeyGeneration",
    "publicKeyRecords",
    "bindingDerivationGenerationRecords",
    "compromisedRevokedKeyIds",
    "compromisedRevokedBindingDerivationGenerations"
  ],
  "additionalProperties": false
}
