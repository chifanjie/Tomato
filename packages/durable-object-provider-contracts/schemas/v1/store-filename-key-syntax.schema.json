{
  "$id": "urn:understand-code:provider-contract:schema:v1:store-filename-key-syntax",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "string",
      "pattern": "^id-(?=[0-9a-v]{2,220}$)(?:[0-9a-v]{8})*(?:[0-9a-v][048cgkos]|[0-9a-v]{3}[0g]|[0-9a-v]{4}[02468acegikmoqsu]|[0-9a-v]{6}[08go])?$"
    },
    {
      "type": "string",
      "pattern": "^idh-[0-9a-f]{64}$"
    }
  ]
}
