{
  "$id": "urn:understand-code:provider-contract:schema:v1:store-provider-filesystem-profile-fields",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "filesystemProfileCode": {
      "type": "string",
      "pattern": "^provider-fs-profile:[0-9a-f]{22}$"
    },
    "filesystemFeatureProfileDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mountOptionProfileDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "filesystemProfileCode",
    "filesystemFeatureProfileDigest",
    "mountOptionProfileDigest"
  ],
  "additionalProperties": false
}
