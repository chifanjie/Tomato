{
  "$id": "urn:understand-code:provider-contract:schema:v1:store-provider-verification-key-id-fields",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providerId": {
      "type": "string",
      "pattern": "^durable-object-provider:(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "usage": {
      "type": "string",
      "enum": [
        "operation_receipt",
        "containment_proof",
        "state_version",
        "journal_version",
        "migration_semantic_proof"
      ]
    },
    "publicKeyBytes": {
      "type": "string",
      "pattern": "^base64url:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    }
  },
  "required": [
    "providerId",
    "usage",
    "publicKeyBytes"
  ],
  "additionalProperties": false
}
